-- ============================================================================
-- CENAS: ABERTURA E UTILITÁRIOS
-- ============================================================================

Scene.create("inicio", function()
    limpa()
    State.set("chuva", true)
    Inventory.give("caderno", 1)
    Narrator.say("KAIRO-7, DISTRITO 9. SEGUNDA-FEIRA, 23h10.")
    Narrator.say("{player.nome}, cápsula 14-C. A chuva ácida bate no acrílico da janela e deixa riscos verdes. Você está sentado na beira do colchão, com os sapatos ainda nos pés e o casaco molhado nas costas.")
    Narrator.say("O comunicador toca na prateleira de cima. Duas notas, uma grave e uma doce. Você sabe quem é pelo toque.")
    Scene.wait()
    Character.say("qi", "Boa noite, " .. trat() .. ". A conta é simples: três mil créditos até domingo, às vinte e três horas.")
    local m = Player.get("motivo")
    if m == "mae" then Character.say("qi", "Sua mãe teve o melhor tratamento que o dinheiro compra. Eu mesma escolhi o médico.")
    elseif m == "aposta" then Character.say("qi", "Eu avisei que o cavalo mancava. Você achou que eu falava de cavalo.")
    elseif m == "implante" then Character.say("qi", "O implante ainda funciona? Foi o que eu pensei. Duas semanas, no máximo.")
    else Character.say("qi", "Seu irmão era uma pessoa educada. Pena que ele esqueceu de levar a dívida com ele.") end
    local c = Scene.choice({
        { id = "prometer", text = "Prometer que vai pagar.", say = fala_escolha("Prometer que vai pagar.") },
        { id = "negociar", text = "Perguntar se dá para negociar o prazo.", say = fala_escolha("Perguntar se dá para negociar o prazo.") },
        { id = "desligar", text = "Desligar sem responder.", say = fala_escolha("Desligar sem responder.") }
    })
    if c == "prometer" then
        Character.say("qi", "Promessa não rende juros, mas rende simpatia. Eu aceito simpatia.")
    elseif c == "negociar" then
        Character.say("qi", "Tudo se negocia. Menos o prazo. Esse eu não fiz. Quem fez foi a aritmética.")
    else
        Narrator.say("A tela volta a ficar preta. Três segundos depois, o comunicador vibra de novo com uma mensagem de texto de Qi: 'Eu espero.'")
    end
    Character.say("qi", "Boa noite. Durma, se conseguir.")
    Scene.wait()
    Narrator.say("Outra mensagem, sem remetente: 'Bar Sinapse. Hoje à noite. Tenho trabalho que paga. — M.'")
    Narrator.say("Você tem 350 créditos no bolso, sete dias e um painel de LED que pisca em verde porque a rede da cápsula caiu de novo.")
    local d = Scene.choice({
        { id = "bar", text = "Ir ao Bar Sinapse agora.", say = fala_escolha("Ir ao Bar Sinapse agora.") },
        { id = "dormir", text = "Dormir e ver o que o amanhã traz.", say = fala_escolha("Dormir e ver o que o amanhã traz.") },
        { id = "janela", text = "Ficar olhando a cidade pela janela.", say = fala_escolha("Ficar olhando a cidade pela janela.") }
    })
    if d == "bar" then
        Narrator.say("Você enfia o casaco ainda úmido, confere a carteira e o comunicador e puxa a porta da cápsula.")
    elseif d == "dormir" then
        Narrator.say("Você deita de lado, com os joelhos dobrados. O LED verde pisca na parede e marca os segundos no escuro. Você não dorme, mas ninguém precisa saber.")
    else
        Narrator.say("No prédio da frente, uma janela acesa mostra alguém passando roupa. Mais acima, o topo da Torre Helix tem as luzes de aviso piscando em vermelho. Nenhuma das duas coisas ajuda a pagar a dívida.")
    end
    Game.save("Cápsula 14-C, segunda à noite")
end)

Scene.create("ajuda", function()
    limpa()
    Narrator.say("MANUAL DO COMUNICADOR (versão gratuita, com anúncios)")
    Narrator.say("1) O relógio não para. Andar, dormir, conversar e trabalhar gastam minutos. A cidade continua se mexendo mesmo quando você não olha.")
    Narrator.say("2) Quem tem rotina tem horário. Se alguém não estiver onde você esperava, tente outra hora ou outro dia.")
    Narrator.say("3) Comunicador não sabe tudo. Gente sabe mais. Quem pergunta, escuta. Quem escuta, volta com algo.")
    Narrator.say("4) O inventário guarda o que você carrega. O caderno guarda o que você decidiu lembrar.")
    Narrator.say("(Anúncio: Calmante Cívico. Um comprimido, uma noite tranquila. Serenia Pharma, empresa do grupo Helix.)")
end)

Scene.create("pagar_qi", function()
    limpa()
    Narrator.say("Seu saldo: " .. State.get("creditos") .. " ¢. Dívida: " .. State.get("divida") .. " ¢.")
    local c = Scene.choice({
        { id = "p50",  text = "Pagar 50 ¢.", say = fala_escolha("Pagar 50 ¢."),  conditions = function() return State.get("creditos") >= 50 and State.get("divida") > 0 end },
        { id = "p200", text = "Pagar 200 ¢.", say = fala_escolha("Pagar 200 ¢."), conditions = function() return State.get("creditos") >= 200 and State.get("divida") > 0 end },
        { id = "p500", text = "Pagar 500 ¢.", say = fala_escolha("Pagar 500 ¢."), conditions = function() return State.get("creditos") >= 500 and State.get("divida") > 0 end },
        { id = "tudo", text = "Pagar tudo o que tenho.", say = fala_escolha("Pagar tudo o que tenho."), conditions = function() return State.get("creditos") > 0 and State.get("divida") > 0 end },
        { id = "nada", text = "Fechar o app.", say = fala_escolha("Fechar o app.") }
    })
    if c == "p50" then paga(50)
    elseif c == "p200" then paga(200)
    elseif c == "p500" then paga(500)
    elseif c == "tudo" then paga(State.get("creditos")) end
    if State.get("divida") <= 0 then
        Narrator.say("O app pisca: DÍVIDA QUITADA. Você fica olhando a palavra por um tempo sem pensar em nada.")
    end
end)

Scene.create("apagao_medico", function()
    limpa()
    Narrator.say("A visão se fecha pelas bordas. O chão chega antes do resto do corpo.")
    Scene.delay(300)
    Narrator.say("Você acorda com a cabeça no concreto e a boca com gosto de ferro. A carteira está mais leve, as costelas doem de um lado só. Alguém te revistou com calma.")
    local perda = math.min(State.get("creditos"), 100)
    State.subtract("creditos", perda)
    State.set("saude", 35)
    Narrator.say("(Perdeu " .. perda .. " ¢. Saúde restaurada a 35.)")
end)

-- ---------- Notícias e rumores ----------

local NOTICIAS = {
    { "A Helix Corp lança hoje o programa Cidade Sem Risco: câmeras novas em cada poste do Distrito 9. Moradores que quiserem recusar podem preencher o formulário 77-B, disponível apenas nas câmeras.",
      "O prefeito afirmou que o Distrito 9 'tem tudo para ser exemplo' e não disse de quê.",
      "Previsão do tempo: chuva ácida à noite, com chance de arrependimento." },
    { "Terça de apagões pontuais. A concessionária culpa a 'sobrecarga criativa' dos moradores e recomenda desligar os letreiros por duas horas. Nenhum letreiro foi desligado.",
      "Fila de quatrocentas pessoas na Farmácia Cívica pela promoção do Calmante Cívico: um comprimido por cidadão, sem receita.",
      "A prefeitura informa que a taxa de homicídios caiu 12%. A taxa de corpos encontrados, também." },
    { "Rinha clandestina: a polícia corporativa promete 'tolerância zero'. Testemunhas dizem ter visto o comandante na plateia, torcendo.",
      "O Mercado Noturno volta hoje às docas. A vigilância sanitária recomenda não comer nada frito. Nem cru. Nem nada.",
      "A Helix chama a batida desta tarde na Avenida Néon de 'rotina de cuidado'." },
    { "A concessionária informa: a manutenção preventiva derrubou a energia do Distrito 9 entre 2h e 6h desta madrugada. Segundo a empresa, 'ninguém foi prejudicado'.",
      "Mais de quarenta mil pessoas ficaram sem luz esta madrugada. Quinze delas ficaram sem monitoramento. A Helix nega que a segunda informação seja relevante.",
      "Rumores de uma inteligência artificial fugitiva circulam na rede. A Helix nega. A Helix sempre nega." },
    { "Sexta! O Mercado Noturno volta às docas. Cuidado com chips de memória baratos: três pessoas passaram o fim de semana lembrando de coisas que não viveram.",
      "A Secretaria de Saúde confirma sete overdoses de Bruma esta semana e diz que 'o número é pequeno diante do total de moradores'.",
      "Pesquisa: 78% dos moradores do Distrito 9 se dizem satisfeitos. Foram entrevistadas nove pessoas." },
    { "Sábado de neon. Três mortes em rinha, duas em churrasco, uma por 'causas corporativas'.",
      "A Rede Livre invadiu o telão do estádio e exibiu quarenta segundos de um olho riscado. A Helix chamou de vandalismo e pediu que ninguém olhasse.",
      "Especialistas dizem que não existe 'droga da cidade'. Existe 'cidadania desajustada'." },
    { "Domingo. O distrito teve uma noite sem sirenes. Os juros continuam correndo.",
      "Missa online às 8h, rinha às 22h, cobrança de juros a qualquer hora.",
      "Previsão: sol por trás da poluição até as 18h. Depois, poluição por trás da poluição." }
}

local RUMORES = {
    { de = 1, ate = 3, t = "Nota de rodapé: a concessionária agendou manutenção preventiva no Distrito 9 para a madrugada de quinta, das 2h às 6h. Moradores devem carregar baterias." },
    { de = 1, ate = 7, t = "Calmante Cívico: um comprimido, uma noite tranquila. Patrocínio: Serenia Farmacêutica, empresa do grupo Helix." },
    { de = 2, ate = 7, t = "Um engenheiro da Helix foi encontrado morto nas docas. A empresa lamenta e informa que ele 'não era funcionário'." },
    { de = 1, ate = 7, t = "Informação técnica sem importância: as câmeras da Cidade Sem Risco funcionam com bateria própria por até quatro minutos em caso de falha de energia." },
    { de = 3, ate = 7, t = "Moradora do Bloco 14 afirma ter visto um gato azul descendo a escada de incêndio. A síndica afirma que não há síndica." },
    { de = 1, ate = 7, t = "A Helix compra mais três quarteirões na Rua das Fachadas Brancas. O prefeito: 'Tudo dentro da lei que a Helix escreveu.'" },
    { de = 2, ate = 7, t = "Pesquisadores notam que as overdoses de Bruma se concentram em três bairros. Os mesmos três, todas as vezes. A Helix nega relação e oferece palestras." },
    { de = 4, ate = 7, t = "A Rede Livre afirma ter 'conversado' com um sistema da Helix. A Helix diz que sistema não conversa. Um engenheiro, em off, diz que ainda não aprenderam a calar este." }
}

Scene.create("jornal", function()
    limpa()
    Narrator.say("A imagem da tela treme. O som chega meio segundo depois do movimento da boca.")
    local d = Time.weekday_index()
    local n = NOTICIAS[d]
    Character.say("tv", n[sorteia("noticia", #n)])
    if math.random(1, 100) <= 70 then
        local pool = {}
        for _, r in ipairs(RUMORES) do if Time.day() >= r.de and Time.day() <= r.ate then pool[#pool + 1] = r.t end end
        if #pool > 0 then
            Narrator.say("Na faixa de baixo, em letras pequenas, passa outro texto:")
            Narrator.say(pool[sorteia("rumor", #pool)])
        end
    end
end)

-- ---------- Cenas de fundo: ouvir, olhar, esbarrar ----------

Scene.create("janela_vista", function()
    limpa()
    local n = sorteia("janela", 6)
    if n == 1 then
        Narrator.say("O quadragésimo andar da Torre Helix está aceso. Está sempre aceso. Você olha por dez minutos e uma silhueta passa pela janela duas vezes, no mesmo sentido, na mesma velocidade.")
    elseif n == 2 then
        Narrator.say("Na janela da frente, um homem passa camisas num varal improvisado. Ele passa a mesma camisa três vezes. Quando percebe que está sendo observado, abaixa a persiana.")
    elseif n == 3 then
        Narrator.say("Um drone de manutenção sobe pelo poste da rua com uma chave de fenda mecânica. Ele aparafusa uma câmera nova no topo, testa, desce, volta e aperta mais uma volta no parafuso.")
    elseif n == 4 then
        Narrator.say("Lá embaixo, um carro branco para. A janela abre só o suficiente para uma mão passar uma caixinha. Outra mão, magra, pega e sai correndo. O carro sai sem pressa.")
    elseif n == 5 then
        if Time.is_night() then
            Narrator.say("Das vinte e três às meia-noite, os letreiros apagam um por um, de baixo para cima, por economia. O último a apagar é o da Serenia Pharma, que pisca duas vezes antes.")
        else
            Narrator.say("Duas crianças soltam uma pipa de saco plástico entre os prédios. Uma câmera da Cidade Sem Risco gira e acompanha a pipa até ela cair.")
        end
    else
        Narrator.say("Um sujeito de casaco amarelo, na calçada, olha para a janela da sua cápsula por muito tempo. Quando você acena, ele levanta o polegar e some entre dois postes.")
    end
end)

Scene.create("escuta_portas", function()
    limpa()
    Narrator.say("Você encosta no ferro frio do corredor e finge olhar o comunicador.")
    local n = sorteia("portas", 6)
    if n == 1 then
        Narrator.say("Atrás da 14-B, um homem e uma mulher falam baixo, em turno de quem já brigou demais para gritar.")
        Narrator.say("Ela: 'Quanto ele pediu?' Ele: 'Quatrocentos.' Ela: 'Pelo quê?' Ele: 'Pela porta. Pela porta, Dalva. Quer pagar para ter porta, ou quer ficar com a vergonha?'")
    elseif n == 2 then
        Narrator.say("Na 14-D, uma TV a todo volume repete o slogan 'Cidade Sem Risco, vida sem medo'. Em intervalos regulares, alguém lá dentro responde: 'Mentira.' Depois o slogan, depois 'Mentira.'")
    elseif n == 3 then
        Narrator.say("Na 14-F, uma criança pergunta quando o pai volta. A mãe fala algo que não dá para ouvir. A criança pergunta de novo. A luz embaixo da porta se apaga.")
    elseif n == 4 then
        Narrator.say("No fim do corredor, Seu Abel ronca de boca aberta, deitado numa cadeira de praia. A tosse dele tem catarro azulado. Do lado, uma caneca de chá frio e uma foto de navio.")
    elseif n == 5 then
        Character.say("neide", "Levaram o Rui da 14-F em maio. Disseram que era 'checagem'. Ele nunca teve nada, só ficava na janela.")
        State.set("ouviu_rui", true)
        Character.say("abel", "Quando eles chamam de checagem, é porque a lista é nova.")
        Narrator.say("As vozes baixam quando uma porta range. Você finge procurar a chave.")
    else
        Narrator.say("Alguém digita muito rápido atrás da 14-E, parando só para respirar. Às vezes sai uma risada seca. Quem está lá dentro não sai há três dias, pelo que dizem os sacos de lixo na porta.")
    end
end)

Scene.create("papo_lavanderia", function()
    limpa()
    Narrator.say("Seu Abel está sentado no banco, de bermuda e camiseta de time, olhando o tambor girar. Dona Neide dobra lençóis sem sair do lugar. Ao lado deles, um menino de uns dez anos, descalço, desenha com carvão no chão de cimento.")
    local n = sorteia("lavanderia", 3)
    if n == 1 then
        Character.say("abel", "Trabalhei trinta anos nas docas. Naquele tempo, um navio de contêiner chegava toda semana. Hoje só chegam navios de uma carga só, e ninguém assina a nota.")
        Character.say("neide", "Abel, ninguém quer ouvir sobre navio.")
        Character.say("abel", "Quinta tem manutenção. Eu já deixei a janela aberta. Cada apagão custa um aquecedor.")
    elseif n == 2 then
        Character.say("neide", "Desde que o gatinho sumiu, a Ishi passa no corredor várias vezes por dia. Coloca o pires às seis e depois sai procurando. Eu disse: 'Ishi, gato de máquina volta sozinho'. Ela olhou para mim com aqueles olhos...")
        Character.say("juca", "Eu vi o gato azul, tia.")
        Character.say("neide", "Juca, não interrompa.")
        Character.say("juca", "Ele desceu pela escada de incêndio e foi pro beco do lámen. Eu vi. Brilhava.")
        State.set("conhece_juca", true)
        State.set("pista_gato", math.max(1, State.get("pista_gato")))
    else
        Character.say("neide", "O Rui da 14-F nunca fez nada. Só olhava a Torre da janela. Aí uma tarde parou um carro branco, e depois de uma semana a esposa já tinha vendido os móveis.")
        State.set("ouviu_rui", true)
        Character.say("abel", "O carro branco nunca para na porta de quem deve. Para na de quem fez a conta certa.")
    end
    local pergunta_rui = State.get("ouviu_rui") and "Perguntar sobre o Rui da 14-F." or "Perguntar quem é o morador da 14-F."
    local c = Scene.choice({
        { id = "ouvir", text = "Continuar ouvindo, sem dizer nada.", say = fala_escolha("Continuar ouvindo, sem dizer nada.") },
        { id = "gato", text = "Perguntar do gato da Dona Ishi.", say = fala_escolha("Perguntar do gato da Dona Ishi."), conditions = function() return State.get("q_gato") >= 1 and State.get("pista_gato") < 1 end },
        { id = "rui", text = pergunta_rui, say = fala_escolha(pergunta_rui) },
        { id = "sair", text = "Pegar o casaco e sair.", say = fala_escolha("Pegar o casaco e sair.") }
    })
    if c == "gato" then
        if not State.get("conhece_juca") then
            Character.say("juca", "Eu sou o Juca. Ouvi você falando do gato da Ishi. Vi um gato azul descendo pela escada de incêndio e indo pro beco do lámen.")
            State.set("conhece_juca", true)
        else
            Character.say("juca", "Eu vi o gato azul. Ele desceu pela escada e foi pro beco do lámen. Eu vi mesmo.")
        end
        State.set("pista_gato", 1)
        Narrator.say("Juca volta a desenhar. O traço no chão tem a forma de um gato com uma orelha torta.")
    elseif c == "rui" then
        if not State.get("ouviu_rui") then
            Character.say("neide", "Rui. Morava na 14-F, no fim do corredor. Foi levado em maio numa 'checagem' da Helix. Nunca teve nada, só ficava na janela olhando a Torre.")
            State.set("ouviu_rui", true)
            Character.say("abel", "Quando eles chamam de checagem, é porque a lista é nova.")
        else
            Character.say("neide", "Ele fazia a conta do mês no caderno. Tinha uma teoria de que os apagões do bairro têm hora marcada. Dizia que a Torre sabia quando a gente ia reclamar.")
            Character.say("abel", "Teoria de quem tem tempo demais.")
        end
        Narrator.say("Seu Abel olha para o tambor. Neide dobra o mesmo lençol pela terceira vez.")
    elseif c == "ouvir" then
        Narrator.say("As vozes voltam à discussão sobre o preço do gás, que subiu pela quarta vez. O tambor termina o ciclo.")
    end
end)

Scene.create("observar_rua", function()
    limpa()
    local n = sorteia("rua", 7)
    if n == 1 then
        Narrator.say("Um drone de propaganda desce, pergunta seu nome e tenta vender um seguro de vida. Você sai do alcance e ele escolhe outro pedestre sem se ofender.")
    elseif n == 2 then
        Narrator.say("Duas crianças disputam uma peça de moto numa poça. A menor ganha, por teimosia, e sai segurando a peça contra o peito. A maior não corre atrás.")
    elseif n == 3 then
        Narrator.say("Uma moto magnética passa a trinta centímetros do seu ombro. O piloto grita 'Sai da frente, defunto!' e não olha para trás. Você sai da frente.")
    elseif n == 4 then
        Narrator.say("Um mendigo-tradutor repete 'Eles estão ouvindo' em quatro idiomas, apontando para o alto-falante da Cidade Sem Risco no poste. O alto-falante responde 'Obrigado pela colaboração' em todos os idiomas.")
    elseif n == 5 then
        Narrator.say("Um holograma de gueixa dança na frente de um bar. O sorriso congela, falha, volta. Os três homens que passam por ela olham para ela e depois para os próprios sapatos.")
    elseif n == 6 then
        Narrator.say("Uma garota de jaqueta amarela te entrega um panfleto de papel de verdade: 'A Rede Livre te vê.' Quando você levanta a cabeça, ela já cruzou a rua.")
        ganha(10)
    else
        Narrator.say("Na calçada em frente à feira, um homem de terno amarrotado conta ampolas azuis de uma sacola. Conta de dez em dez. Chega a noventa, esquece, volta ao um. Ninguém para.")
        State.add("lore_bruma", 1)
    end
end)

Scene.create("camelos", function()
    limpa()
    Narrator.say("Você encosta numa barraca de cabos. A camelô, de óculos grossos e luva sem dedos, nem levanta o rosto.")
    Character.say("camelo", "Procurando o quê? Peça de implante, a senhora da ponta tem. Chip de memória, é com o rapaz do cano. Informação, eu não vendo. Eu dou de graça para quem compra três metros de cabo.")
    local c = Scene.choice({
        { id = "cabo", text = "Comprar três metros de cabo (10 ¢).", say = fala_escolha("Comprar três metros de cabo (10 ¢)."), conditions = function() return State.get("creditos") >= 10 end },
        { id = "rapaz", text = "Perguntar sobre 'o rapaz do cano'.", say = fala_escolha("Perguntar sobre 'o rapaz do cano'.") },
        { id = "torre", text = "Perguntar o que se comenta sobre a Torre.", say = fala_escolha("Perguntar o que se comenta sobre a Torre.") },
        { id = "sair", text = "Agradecer e seguir.", say = fala_escolha("Agradecer e seguir.") }
    })
    if c == "cabo" then
        State.subtract("creditos", 10)
        Narrator.say("Ela enrola o cabo num cotovelo, corta com os dentes e amarra com uma fita. (-10 ¢)")
        Character.say("camelo", "Ouviu falar que a Helix está comprando quarteirões na rua das Fachadas? Compram tudo, menos o que o vento deixa solto. Eles não gostam de coisa solta.")
    elseif c == "rapaz" then
        Character.say("camelo", "Zeca. Fica nos becos, depois da Avenida Baixa. Não pergunte o que ele vende. Pergunte o que ele tem. É diferente, e ele gosta mais.")
        State.set("rumor_zeca", true)
        State.set("rumor_zeca_camelo", true)
    elseif c == "torre" then
        Character.say("camelo", "Que a Torre tem um andar embaixo da terra. Que alguém de lá desce às quintas e volta pálido. Que a luz azul, às três da manhã, não é de lâmpada.")
        State.add("lore", 0)
    end
end)

Scene.create("boato", function()
    limpa()
    State.subtract("creditos", 30)
    limpa()
    Narrator.say("Bartô coloca um drink azul na sua frente sem perguntar o que você queria. Arde na língua e deixa gosto de bateria. (-30 ¢)")
    local n = sorteia("boato", 6)
    if n == 1 then
        Narrator.say("Na mesa ao lado, dois homens de macacão discutem em voz baixa.")
        Narrator.say("'A velha Ishi perdeu o gato. Chora o dia todo no corredor do 14, coitada.' 'Gato de máquina não some. Alguém pegou.'")
    elseif n == 2 then
        Narrator.say("Um casal de meia-idade dividindo um prato de amendoins fala sobre dinheiro como quem fala de um parente doente.")
        Narrator.say("'O Taro está procurando entregador faz dias, pagando bem.' 'Ele sempre paga bem.' 'Não é isso. É que ele está procurando um entregador específico.'")
    elseif n == 3 then
        Narrator.say("Uma mulher com camiseta de lutadora conversa com um homem que tem a mão enfaixada.")
        Narrator.say("'O Rex nunca perdeu em casa.' 'Quem foi o último que tentou?' 'O último está na ala dos fundos do Sal, olhando o teto.'")
    elseif n == 4 then
        Narrator.say("Na mesa do canto, um sujeito de capuz xadrez fala sem mexer a boca, mostrando algo no pulso para um cliente.")
        Narrator.say("'Esta noite eu tenho uma infância inteira de alguém que morreu em março. Quatro minutos. Serve para quem está sozinho.'")
    elseif n == 5 then
        Narrator.say("Dois homens de colete reflexivo, longe dos outros, falam das docas.")
        Narrator.say("'Madame Qi precisa de gente para entrega. Paga em desconto de dívida.' 'E o risco?' 'Tem risco em tudo que tem desconto.'")
    else
        Narrator.say("Perto do balcão, uma mulher sentada sozinha digita no comunicador e apaga o que escreveu.")
        Narrator.say("Atrás de você alguém sussurra: 'A Helix trancou um laboratório no subnível 9.' E outra voz responde: 'Fecha a boca. Aqui até o gelo ouve.'")
    end
    local c = Scene.choice({
        { id = "ouvir", text = "Continuar bebendo e ouvindo.", say = fala_escolha("Continuar bebendo e ouvindo.") },
        { id = "aproximar", text = "Se aproximar da mesa e entrar na conversa.", say = fala_escolha("Se aproximar da mesa e entrar na conversa.") },
        { id = "barman", text = "Perguntar ao Bartô o que ele ouve por aqui.", say = fala_escolha("Perguntar ao Bartô o que ele ouve por aqui.") }
    })
    if c == "aproximar" then
        Narrator.say("Você puxa uma cadeira. A conversa muda de assunto imediatamente, para o preço da cerveja de contrabando. Eles esperam você ir embora para voltar ao que estavam dizendo.")
    elseif c == "barman" then
        Character.say("barman", "Eu ouço tudo e esqueço por ordem de importância. A senhora de vermelho, no reservado dos fundos, pediu o mesmo vinho há quatorze noites. Ela nunca bebeu.")
        Narrator.say("O androide volta a polir o copo. A pressão da mão dele não muda.")
    end
end)

Scene.create("forum_nexus", function()
    limpa()
    Narrator.say("Você escolhe um terminal livre, ao lado de um adolescente que dorme com a testa na bancada, e abre a rede aberta do distrito. Os fóruns têm pouca moderação e muito medo.")
    local n = sorteia("forum", 5)
    if n == 1 then
        Narrator.say("Tópico fixado: 'O OLHO RISCADO'. Um desenho que aparece em muros do distrito. Mais de quatrocentas respostas, nenhuma assinada. A primeira diz: 'Quem desenha é quem acorda. Quem pergunta é quem dorme.'")
    elseif n == 2 then
        Narrator.say("Tópico: 'BRUMA — LOTE 9'. Uma lista de nomes de bairros e datas de distribuição. O mesmo moderador anônimo marca a lista em vermelho com uma única frase: 'Quem recebeu primeiro? Quem protestou depois?'")
        State.add("lore_bruma", 1)
    elseif n == 3 then
        Narrator.say("Tópico: 'ONDE ESTÁ A VOZ?'. Alguém conta que ouviu uma mulher cantando de dentro de um servidor desligado. Respostas: risadas, gente pedindo prova, um engenheiro dizendo 'não procure isso na rede, procure embaixo dela'.")
    elseif n == 4 then
        Narrator.say("Tópico: 'MANUTENÇÃO PREVENTIVA'. Alguém compara datas de apagões nos últimos dois anos e conclui que todo apagão acontece na semana em que algum bairro vota contra um projeto da Helix. Quinze respostas dizem 'conspiração'. Uma diz 'quinta, 2h'.")
    else
        Narrator.say("Tópico: 'VENDO CRACHÁ. NÃO PERGUNTE'. Seis mensagens apagadas. A sétima: 'Quem precisa entra. Quem pergunta demais, não.' Contato: um cano, nos becos.")
    end
end)

Scene.create("observar_baixa", function()
    limpa()
    local n = sorteia("baixa", 4)
    if n == 1 then
        Narrator.say("Um homem está sentado no meio-fio, de costas retas, olhando uma parede em branco. Uma menina de uns doze anos conta as ampolas que ele tem no bolso. Ele deixa. Ela guarda três e devolve o resto.")
    elseif n == 2 then
        Narrator.say("Uma mulher empurra um carrinho de feira com um homem sentado dentro, de olhos abertos, imóvel. Ela para a cada esquina, ajeita a manta, e continua.")
    elseif n == 3 then
        Narrator.say("Do outro lado da rua, dois agentes de colete branco anotam placas de motos. Quando chegam na terceira, um dos motoristas oferece uma nota. Um dos agentes aceita. O outro anota que aceitou.")
    else
        Narrator.say("Alguém desenhou um olho riscado numa grade, com tinta fresca. Embaixo, outra mão escreveu: 'Ele vê quem fecha o olho.' A tinta ainda escorre.")
    end
end)

Scene.create("olhar_rio", function()
    limpa()
    local n = sorteia("rio", 3)
    if n == 1 then
        Narrator.say("Um garoto de uns catorze anos pesca peças com um ímã amarrado numa corda. Ele puxa, olha, joga de volta. Em vinte minutos pega uma bobina inteira e a guarda no cós. Não fala com você.")
    elseif n == 2 then
        Narrator.say("Dois homens de casaco comprido arrastam uma sacola preta até a beira do cais. Eles param, olham em volta, depois olham para você. Um assobia. Você vira o rosto para o outro lado. Quando olha de novo, o cais está vazio e há uma marca de arrasto.")
    else
        Narrator.say("A água tem uma película de óleo que se abre quando algum peixe sobe, mostra a barriga e afunda de novo. Cartazes de 'Proibido nadar' estão enterrados na lama há tantos anos que as letras sumiram.")
    end
end)

Scene.create("mercado_passeio", function()
    limpa()
    local n = sorteia("mercado", 4)
    if n == 1 then
        Narrator.say("Uma banca vende gravações de voz em tubos de vidro. A etiqueta de cada um tem um nome e uma data. A vendedora diz: 'Quem morreu em abril sai mais caro. Quem morreu cedo sai mais barato.'")
    elseif n == 2 then
        Narrator.say("Uma mulher de cabelo curtíssimo vende o próprio cabelo a um comprador de perucas. Ele pesa na balança, ela confere o peso, os dois discutem por cinco créditos. Ela leva quarenta e sai sem olhar para trás.")
    elseif n == 3 then
        Narrator.say("Uma banca de 'Calmante Cívico original' tem uma pilha de caixas lacradas. O vendedor, sem camisa, avisa: 'Esse aqui tem lacre da Serenia. O outro, o azul, é o que a Serenia não sabe que existe.'")
        State.add("lore_bruma", 1)
    else
        Narrator.say("Uma criança vende bilhetes de rifa de um rim. O bilhete custa um crédito. Ela garante que o rim é dela e que 'já tem dois'. A mãe observa de trás de uma coluna e não interfere.")
    end
end)

Scene.create("observar_torre", function()
    limpa()
    Narrator.say("Você se encosta numa vitrine vazia e olha a Torre Helix. Dois seguranças de terno branco estão de pé na entrada, imóveis. A cada três minutos um deles toca o ouvido com dois dedos.")
    local n = sorteia("torre", 3)
    if n == 1 then
        Narrator.say("Um furgão de manutenção entra por uma rampa lateral, deixa um técnico, sai. O técnico entra por uma porta metálica, sem crachá, sem dar bom-dia a ninguém.")
    elseif n == 2 then
        Narrator.say("Uma mulher de blazer cinza sai pela porta giratória, pára na calçada, olha para o céu um instante e volta para dentro sem ter dado um passo.")
    else
        Narrator.say("No quadragésimo andar, uma luz branca apaga e acende. Lá embaixo, na calçada, uma câmera gira e confere se você ainda está olhando.")
    end
    curioso("Você nota que as câmeras da rua dependem de uma caixa de energia na esquina, trancada com um cadeado novo e uma etiqueta amarela: 'Manutenção: não abrir sem aviso'.")
end)


-- ============================================================================
-- CENAS: PRIMEIRO ENCONTRO COM CADA PERSONAGEM
-- (aparência e personalidade em falas e gestos; nada de resumo)
-- ============================================================================

local function saud()
    local h = Time.hour()
    if h >= 5 and h < 12 then return "Bom dia" elseif h >= 12 and h < 18 then return "Boa tarde" end
    return "Boa noite"
end

local function ishi_retorna(a)
    if a == "regando o bonsai" then
        Narrator.say("Ela volta a cuidar do bonsai, molhando uma folha por vez com a seringa.")
    elseif a == "olhando a feira" then
        Narrator.say("Ela volta a examinar as barracas, comparando as peças sem tocar nelas.")
    elseif a == "cuidando da horta" then
        Narrator.say("Ela volta a prender o caule do tomateiro com barbante, conferindo se a folha ficou firme.")
    elseif a == "ouvindo rádio" then
        Narrator.say("Ela volta a ouvir o rádio no colo. O polegar procura o botão de sintonia, mas não muda a estação.")
    else
        Narrator.say("Ela retoma a atividade sem interromper o que estava fazendo.")
    end
end

Scene.create("intro_ishi", function()
    limpa()
    local a = ativ("ishi")
    if a == "regando o bonsai" then
        Narrator.say("No fim do corredor, uma senhora de colete acolchoado rega um bonsai de vinte centímetros com uma seringa sem agulha. Molha três folhas de cada vez e confere se ficaram verdes antes de molhar as próximas. Ao lado do vaso, um pires de ração e uma garrafa térmica dividem o espaço de um banquinho baixo.")
    elseif a == "olhando a feira" then
        Narrator.say("Entre duas barracas, uma senhora de colete acolchoado olha a mercadoria sem tocar em nada. Os camelôs a cumprimentam pelo nome. Ela responde a cada um com um aceno e uma pergunta sobre os filhos, também pelo nome.")
    elseif a == "cuidando da horta" then
        Narrator.say("No telhado, uma senhora de colete acolchoado prende uma folha de tomate com barbante e afasta uma lagarta com a unha. As caixas de cultivo estão alinhadas entre as antenas.")
    else
        Narrator.say("Uma senhora de colete acolchoado está sentada num banquinho dobrável em frente à porta 14-A, com um rádio de pilha no colo, volume quase em zero. Perto do pé dela há um pires de ração intacto, com uma película de poeira, e uma garrafa térmica encostada na parede.")
    end
    Narrator.say("Na parede atrás dela, um cartaz escrito à mão: PROCURA-SE MOCHI. GATO-DRONE, ORELHA ESQUERDA TORTA. RESPONDE A 'BIBI-BIBI'. Dá para ver que ela refez a letra três vezes. A de baixo, trêmula, é mais velha. A de cima é firme.")
    Narrator.say("Acima da porta, uma plaquinha de madeira entalhada: KENJI & ISHI.")
    Narrator.say("Ela te olha de baixo para cima, parando nos seus sapatos.")
    Character.say("ishi", saud() .. ", " .. viz() .. ". Tire o sapato no tapete se for entrar. Se for só passar, pise onde o chão está limpo, que é o canto da parede. O resto eu ainda não lavei hoje.", { effect = "wave", color = "#9bd8b0", speed = 20 })
    apresentar("ishi")
    local c = Scene.choice({
        { id = "nome", text = "'" .. saud() .. ", Dona Ishi.' (Chamar pelo nome.)",
              say = fala_escolha("'" .. saud() .. ", Dona Ishi.'") },
        { id = "gato", text = "Perguntar sobre o cartaz.", say = fala_escolha("Perguntar sobre o cartaz.") },
        { id = "passar", text = "Fazer um aceno e seguir caminho.", say = fala_escolha("Fazer um aceno e seguir caminho.") }
    })
    if c == "nome" then
        Character.say("ishi", "Você sabe o meu nome. Aqui ninguém sabe o nome de ninguém, só o número da porta.")
        Narrator.say("Você aponta a plaquinha acima da porta. Ela olha para ela, como se tivesse esquecido que estava ali.")
        Character.say("ishi", "Kenji. Meu marido. Ele era eletricista da concessionária. Entalhou isso numa noite em que a energia caiu, com uma faca de pão e uma lanterna.")
        local d = Scene.choice({
            { id = "chá", text = "'Ele entalhou bem.'", say = fala_escolha("'Ele entalhou bem.'") },
            { id = "agora", text = "'E agora, onde ele está?'", say = fala_escolha("'E agora, onde ele está?'") }
        })
        if d == "chá" then
            Character.say("ishi", "Entalhou. Torto em duas letras, mas eu nunca corrigi. Aceita um chá? É chá de arroz torrado, não é de verdade, mas está quente.")
            if a == "olhando a feira" then
                Narrator.say("Ela tira uma garrafa térmica pequena da bolsa de lona, apoia o copo sobre uma caixa vazia e serve um pouco de chá.")
            elseif a == "cuidando da horta" then
                Narrator.say("Ela limpa a terra dos dedos, pega a garrafa térmica guardada sob o banco do telhado e serve um pouco no copo.")
            else
                Narrator.say("Ela desenrosca a tampa da garrafa térmica e serve um dedo no copo. O copo tem uma rachadura colada com esmalte de unha vermelho.")
            end
            local e = Scene.choice({
                { id = "aceito", text = "Aceitar o chá.", say = fala_escolha("Aceitar o chá.") },
                { id = "recuso", text = "Recusar educadamente.", say = fala_escolha("Recusar educadamente.") }
            })
            if e == "aceito" then
                Narrator.say("Tem gosto de arroz queimado e de garrafa velha. Você bebe tudo. Ela te observa terminar com atenção demais.")
                local origem = Player.get("origem")
                local observacao = "Mãos de quem já precisou aprender a se virar."
                if origem == "entregador" then observacao = "Mãos de quem passa o dia segurando um guidão."
                elseif origem == "helix" then observacao = "Mãos de quem passou tempo demais diante de uma tela."
                elseif origem == "sucata" then observacao = "Mãos de quem trabalha com ferro."
                elseif origem == "ringue" then observacao = "Mãos de quem já apanhou e continuou de pé." end
                local convite = "Volte quando quiser, " .. viz() .. ". O pires é do Mochi, mas o banquinho é de quem aparecer."
                if a == "olhando a feira" then convite = "Quando passar pelo corredor, apareça para outro chá, " .. viz() .. "."
                elseif a == "cuidando da horta" then convite = "Quando eu descer para o corredor, guarde um minuto para outro chá, " .. viz() .. "." end
                Character.say("ishi", observacao .. " O Kenji tinha mãos assim. " .. convite, { effect = "wave", color = "#9bd8b0", speed = 20 })
                conf("ishi", 2)
            else
                Character.say("ishi", "Faz bem. Quem aceita chá de todo mundo acaba devendo conversa.")
                conf("ishi", 1)
            end
            ishi_retorna(a)
        else
            Character.say("ishi", "Ele foi trabalhar numa quinta e não voltou. A empresa mandou um envelope e um pêsame de duas linhas. A última linha tinha um erro de digitação.")
            ishi_retorna(a)
            conf("ishi", 2)
        end
    elseif c == "gato" then
        Character.say("ishi", "O Mochi. Meu marido comprou o filhote numa feira, com a orelha já torta. Disse ao vendedor que era defeito de fábrica. O vendedor disse que era 'característica'. Kenji ficou rindo a semana toda.")
        Narrator.say("Ela olha para o pires e não diz mais nada sobre o gato.")
        Character.say("ishi", "Eu não estou pedindo nada a você. Só peço que não pise no pires.")
        Narrator.say("Você desvia do pires e pisa no canto limpo do chão. Ela percebe e anota.")
        conf("ishi", 1)
        ishi_retorna(a)
    else
        ishi_retorna(a)
    end
end)

Scene.create("intro_taro", function()
    limpa()
    if ativ("taro") == "dormindo" then
        Narrator.say("A cortina de ferro do Lámen do Taro está a meio caminho. As panelas estão frias e, atrás do biombo, um homem de ombros largos dorme sentado, com o avental ainda amarrado. Um letreiro de gato pisca sobre a porta.")
        Character.say("taro", "Se veio comer, volta às cinco. Se veio me acordar, fala baixo e fala rápido.", { effect = "wave", color = "#ffbd66", speed = 18 })
        apresentar("taro")
        local c = Scene.choice({
            { id = "horario", text = "Perguntar que horas ele abre.", say = fala_escolha("Perguntar que horas ele abre.") },
            { id = "gato", text = "Comentar o gato holográfico no letreiro.", say = fala_escolha("Comentar o gato holográfico no letreiro.") },
            { id = "sair", text = "Deixar Taro voltar a dormir.", say = fala_escolha("Deixar Taro voltar a dormir.") }
        })
        if c == "horario" then
            Character.say("taro", "Cinco da manhã. Caldo começa antes do sol, quando ele resolve aparecer.")
        elseif c == "gato" then
            Character.say("taro", "O braço quebrou faz sete anos. Meu pai mandou deixar assim. É o gato mais honesto da avenida.")
        else
            Character.say("taro", "Boa escolha. O silêncio é de graça, pelo menos até eu abrir.")
        end
        return
    end
    Narrator.say("O Lámen do Taro tem seis banquetas e cinco ocupadas. Atrás do balcão, um homem de ombros largos e antebraços cobertos de marcas redondas de queimadura grita pedidos em japonês, português e numa mistura de termos de oficina e palavrões.")
    Narrator.say("Num canto, um garoto de capuz não fez pedido nenhum. Taro empurra uma tigela até ele junto com os hashis, sem olhar, e vira de costas para não ter que ouvir agradecimento.")
    Character.say("taro", "Banqueta da ponta! Primeira vez? Dá para ver. Você olha o gato do holograma como se ele fosse responder.", { effect = "wave", color = "#ffbd66", speed = 18 })
    apresentar("taro")
    local c = Scene.choice({
        { id = "lamen", text = "Pedir um lámen.", say = fala_escolha("Pedir um lámen.") },
        { id = "garoto", text = "Perguntar sobre o garoto de capuz.", say = fala_escolha("Perguntar sobre o garoto de capuz.") },
        { id = "gato", text = "Comentar o braço quebrado do gato.", say = fala_escolha("Comentar o braço quebrado do gato.") }
    })
    if c == "lamen" then
        if State.get("creditos") >= 15 then
            State.subtract("creditos", 15)
            curar(15)
            Narrator.say("Taro desce uma tigela de aço fundo, enche até a borda e afunda uma gema mole no centro com a ponta do hashi. (-15 ¢, +15 saúde)")
            Character.say("taro", "Caldo de osso de verdade, hoje. Não conta para ninguém. A vigilância sanitária ainda acha que osso é luxo.")
        else
            Character.say("taro", "Sem crédito? Senta e come. Depois a gente conversa sobre o que você tem de útil.")
            curar(15)
            Narrator.say("Ele serve uma tigela pequena e empurra os hashis. Você come de cabeça baixa. (+15 saúde)")
        end
        conf("taro", 1)
    elseif c == "garoto" then
        Character.say("taro", "O Juca. Aparece cedo e fica até eu fechar. Eu não cobro. Se cobrasse, ele ia começar a pagar com coisa que não tem.")
        State.set("conhece_juca", true)
        Narrator.say("Taro limpa o balcão com um pano duas vezes no mesmo lugar.")
        Character.say("taro", "A mãe dele toma Bruma. Quando ela esquece que tem filho, a comida vem daqui. Só isso.")
        conf("taro", 2)
    else
        Character.say("taro", "Faz sete anos. Meu pai pagou por um holograma com os dois braços e entregaram esse. Eu deixei assim. É o gato mais honesto da avenida.")
        Narrator.say("Ele ri com a boca inteira, sem se importar com quem está olhando.")
        conf("taro", 2)
    end
    Character.say("taro", "Você é do Bloco 14, não é? Já te vi passar com cara de quem pulou o jantar. Come direito, hein. Semana ruim aguenta-se de estômago cheio.")
end)

Scene.create("intro_sal", function()
    limpa()
    Narrator.say("A clínica tem uma única luz de cirurgia funcionando. Embaixo dela, um homem de jaleco sujo costura a coxa de um garoto de uns quinze anos, que morde um pano. Na bancada, uma caneca de café sem alça e uma garrafa de uísque sem rótulo, na mesma altura.")
    curioso("Um prontuário aberto na bancada, de letra miúda: 'Paciente: homem, 31, brumado. Overdose. Ala dos fundos.' Embaixo, em outra caneta: 'Terceiro este mês. Mesmo quarteirão.'")
    Character.say("sal", "Fecha a porta. Chuva ácida faz o antisséptico trabalhar em dobro. Você, de pé aí. Segura a lâmpada. Não, a outra mão. Isso.", { effect = "wave", color = "#ffb58a", speed = 18 })
    apresentar("sal")
    local c = Scene.choice({
        { id = "segurar", text = "Segurar a lâmpada.", say = fala_escolha("Segurar a lâmpada.") },
        { id = "preco", text = "Perguntar o preço do atendimento.", say = fala_escolha("Perguntar o preço do atendimento.") },
        { id = "voltar", text = "Dizer que volta depois.", say = fala_escolha("Dizer que volta depois.") }
    })
    if c == "segurar" then
        Narrator.say("Você segura a lâmpada a trinta centímetros da perna. O garoto respira alto pelo nariz. Sal fala sem tirar os olhos do ponto:")
        Character.say("sal", "Quadríceps, vasto lateral. A faca entrou quatro centímetros. Quem usou tinha mão curta e vontade pequena. Aguenta, filho, isso é o mais fácil da vida.")
        Narrator.say("A mão dele treme até a agulha encostar na pele. Depois, para. Ele dá vinte e dois pontos, corta o fio com os dentes e dá um tapinha na perna.")
        Character.say("sal", "Seu estômago aguentou. Bom. Quem desvia o olho aos vinte pontos costuma virar paciente.")
        Narrator.say("O garoto sai mancando, com uma gaze na mão. Antes de passar pela porta ele diz 'valeu, doutor' sem olhar para ninguém.")
        Character.say("sal", "Se ele voltar com bala, eu aviso a mãe. Doc Sal. O preço está na parede, a política de reembolso está na minha cara.")
        conf("sal", 2)
    elseif c == "preco" then
        Character.say("sal", "Quarenta, remendo. Duzentos, carne nova. Se for dívida, eu não pergunto. Se for ferida de bala, eu pergunto menos ainda.")
        conf("sal", 1)
    else
        Character.say("sal", "Todo mundo volta depois. Quase sempre em pior estado.")
    end
    Narrator.say("Ele esfrega as mãos com um pano que já foi branco, pega a caneca, cheira, bebe. Não tem café ali. Ele não parece se importar de você ter percebido.")
end)

Scene.create("intro_pixel", function()
    limpa()
    if World.player_room() == "telhado" then
        Narrator.say("Na beira do telhado, de costas, uma garota de moletom largo balança as pernas no vazio. Ao lado dela, um cobertor térmico dobrado, uma garrafa de energético e um pacote de balas em forma de engrenagem. Ela não vira.")
        Character.say("pixel", "Se vai pular, espera eu sair. Se vai olhar, senta onde o vento não bate. É ali, perto da caixa d'água.", { effect = "wave", color = "#6fe3ff", speed = 18 })
        apresentar("pixel")
        local c = Scene.choice({
            { id = "sentar", text = "Sentar perto da caixa d'água.", say = fala_escolha("Sentar perto da caixa d'água.") },
            { id = "perguntar", text = "'Quem é você?'", say = fala_escolha("'Quem é você?'") }
        })
        if c == "sentar" then
            Narrator.say("Você se senta. Ela estende o pacote de balas sem olhar. Você pega uma. É de ácido cítrico demais.")
            Character.say("pixel", "Eu venho aqui porque lá embaixo todo mundo fala. Aqui só tem a Torre e eu. Ela nunca responde, mas também não manda eu ir embora.")
            conf("pixel", 2)
        else
            Character.say("pixel", "Pixel. Esse é o nome que eu uso no trabalho. O de verdade eu esqueci. Estava pesado.")
            conf("pixel", 1)
        end
    else
        Narrator.say("No terminal do fundo, uma garota de moletom largo e cabelo azul preso com um lápis disputa algo contra dois adultos que a cercam. Três janelas de aposta piscam nas telas dela. Ela mastiga uma bala, digita sem olhar o teclado e comenta tudo em voz alta:")
        Character.say("pixel", "Não, não, vai para o buraco... é assim, olha, é assim... pronto.", { effect = "glitch", color = "#6fe3ff", speed = 16 })
        Narrator.say("As duas telas dos adultos ficam vermelhas ao mesmo tempo. Ela estica a mão aberta sem tirar os olhos do próprio monitor.")
        Character.say("pixel", "Pagam, ou eu mostro o histórico de vocês para a mãe de vocês?")
        Narrator.say("Um dos homens tira notas amassadas do bolso e deixa na mão dela. O outro sai sem dizer nada. Ela guarda o dinheiro no moletom e finalmente olha para você.")
        Character.say("pixel", "Você olha demais para as minhas telas. Isso quer dizer que não entende nada ou entende demais. Qual dos dois?")
        apresentar("pixel")
        local c = Scene.choice({
            { id = "nada", text = "'Não entendo nada.'", say = fala_escolha("'Não entendo nada.'") },
            { id = "entendo", text = "'Entendo o suficiente.'", say = fala_escolha("'Entendo o suficiente.'") },
            { id = "sentar", text = "'Só vim procurar um lugar para sentar.'", say = fala_escolha("'Só vim procurar um lugar para sentar.'") }
        })
        if c == "nada" then
            Character.say("pixel", "Perfeito. Os que entendem demais ficam metidos. Primeira lição, de graça: toda senha é o nome de alguém que a pessoa perdeu. Só falta descobrir quem.")
            conf("pixel", 2)
        elseif c == "entendo" then
            Character.say("pixel", "Então me diz que número eu estou pensando, de um a dez.")
            Narrator.say("Você diz sete. Ela mexe a boca, mastigando.")
            Character.say("pixel", "Era oito. Mas você tem cara de sete. Fica.")
            conf("pixel", 1)
        else
            Character.say("pixel", "Sentar custa cinco créditos por hora. Ou de graça, se você me ajudar numa coisa depois. Eu sempre cobro, só muda a moeda.")
            conf("pixel", 1)
        end
    end
end)

Scene.create("intro_mira", function()
    limpa()
    Narrator.say("Num reservado perto da saída, uma mulher de casaco cinza-escuro mexe um copo de água sem gelo. Está sentada de frente para a porta e com a parede nas costas. A cada pessoa que entra, o polegar dela bate uma vez na lateral do copo. Quando você entra, bate duas.")
    Character.say("mira", "Você. Senta. Não aí, tem corrente de ar. Eu quero que você me ouça.", { effect = "neon", color = "#e8bbff", speed = 18 })
    apresentar("mira")
    Narrator.say("Ela desliza sobre a mesa um cartão de dados: o número da sua cápsula, o endereço do Bloco 14, a data de vencimento da dívida e o valor, com os juros por dia. Não há nome, só um identificador de contrato impresso em fonte pequena, como uma empresa faria.")
    Character.say("mira", "Não é ameaça. É currículo. Eu só trabalho com quem eu conheço.")
    local c = Scene.choice({
        { id = "quem", text = "'Quem é você?'", say = fala_escolha("'Quem é você?'") },
        { id = "saber", text = "'Você sabe demais sobre mim.'", say = fala_escolha("'Você sabe demais sobre mim.'") },
        { id = "blefe", text = "'Eu também sei algumas coisas sobre você.' (blefar)", say = fala_escolha("'Eu também sei algumas coisas sobre você.' (blefar)"), conditions = function() return tem("cara_de_pau") end },
        { id = "sair", text = "Levantar e sair.", say = fala_escolha("Levantar e sair.") }
    })
    if c == "sair" then
        Character.say("mira", "Se sair agora, vai para a mesma dívida de antes. Eu espero até amanhã. Só até amanhã.")
        return
    elseif c == "quem" then
        Character.say("mira", "Mira Voss. Intermediária. Eu junto quem precisa com quem pode, e cobro de quem aprende comigo.")
    elseif c == "saber" then
        Character.say("mira", "Eu sei o que está disponível. O resto é sorte e paciência. Você está disponível, só isso.")
    else
        Narrator.say("A mulher te olha sem mover a cabeça. O polegar para de bater no copo.")
        Character.say("mira", "Ótimo. Alguém com coragem de mentir é mais útil do que alguém que diz a verdade devagar. Continue.")
        conf("mira", 1)
    end
    Character.say("mira", "Um mensageiro da Helix morreu nas Docas esta madrugada. Carregava um chip chamado ORFEU. Quero esse chip antes que os cães da Helix o encontrem. Pago mil e quinhentos. Adianto quinhentos agora.", { effect = "pulse", color = "#e8bbff", speed = 18 })
    local d = Scene.choice({
        { id = "aceitar", text = "'Aceito. Onde começo?'", say = fala_escolha("'Aceito. Onde começo?'") },
        { id = "orfeu", text = "'O que é ORFEU?'", say = fala_escolha("'O que é ORFEU?'") },
        { id = "recusar", text = "'Não é minha praia.'", say = fala_escolha("'Não é minha praia.'") }
    })
    if d == "orfeu" then
        Character.say("mira", "Se eu soubesse, não pagaria tanto. Só sei que a Helix mataria por ele. E que alguém de dentro quer que vaze.")
        d = Scene.choice({
            { id = "aceitar", text = "'Aceito. Onde começo?'", say = fala_escolha("'Aceito. Onde começo?'") },
            { id = "recusar", text = "'Ainda assim, não.'", say = fala_escolha("'Ainda assim, não.'") }
        })
    end
    if d == "aceitar" then
        State.set("q_main", 1)
        State.set("mira_conhece", true)
        Room.reveal("docas", "conteineres")
        ganha(500)
        Character.say("mira", "Docas. Lado sul, onde os contêineres ficam abertos. Procure o corpo, depois o chip. Quando tiver, leve ao Pixel, no NetHaven. Ele abre.")
        Narrator.say("Mira empurra o copo de água até você. Não acrescenta nada.")
        conf("mira", 1)
        Game.save("Contrato com Mira Voss")
    else
        Character.say("mira", "Então esqueça que me viu. Mas a oferta fica de pé por mais um dia.")
    end
end)

Scene.create("intro_qi", function()
    limpa()
    Narrator.say("Em frente ao armazém, sob uma lona e uma lâmpada pendurada num fio, uma senhora de cabelo branco em trança serve chá de um bule de ferro em três xícaras de porcelana. Os óculos dela são pequenos e redondos. Dois homens de casaco comprido estão de pé atrás da cadeira e não olham para nada.")
    Narrator.say("Ela põe um livro-caixa fechado ao lado do bule, sem pressa, como quem arruma a mesa para jantar.")
    Character.say("qi", "Meu " .. trat() .. ". O contrato já me trouxe até você. O rosto é só confirmação.", { effect = "pulse", color = "#ffbd66", speed = 18 })
    apresentar("qi")
    local c = Scene.choice({
        { id = "tres", text = "'Por que três xícaras?'", say = fala_escolha("'Por que três xícaras?'") },
        { id = "chá", text = "Aceitar o chá sem dizer nada.", say = fala_escolha("Aceitar o chá sem dizer nada.") },
        { id = "negociar", text = "'Vim negociar.'", say = fala_escolha("'Vim negociar.'") }
    })
    if c == "tres" then
        Character.say("qi", "Uma para mim. Uma para quem deve. Uma para quem vai cobrar. Hoje a terceira fica vazia. Veja quanto isso depende de você.")
    elseif c == "chá" then
        Narrator.say("Você pega a xícara. O chá é de jasmim e está na temperatura exata de beber sem pensar. Qi observa você beber a primeira metade.")
        Character.say("qi", "Aqui recusar o chá é declarar guerra. Aceitar é só aceitar um chá. Você tem boa educação, ou tem muito medo. Em Kairo-7 é a mesma coisa.")
    else
        Character.say("qi", "Negociar é um verbo bonito. Eu nunca grito. Gritar é para quem tem pressa. Eu tenho até domingo.")
    end
    local m = Player.get("motivo")
    if m == "mae" then Narrator.say("Qi vira uma página do livro-caixa sem abrir os olhos e lê de memória: 'Sua mãe. Quarto 214, alta em dezenove de março.' Ela olha para você. 'Eu não gosto de gente que paga em silêncio.'")
    elseif m == "aposta" then Narrator.say("Qi coloca um dado de osso na mesa, vira para o seis e empurra com um dedo até você. 'Lembrança de uma noite em que você perdeu com muita elegância.'")
    elseif m == "implante" then Narrator.say("Qi olha para a nuca de quem está na frente dela e franze a testa: 'Que cirurgião fez isso? Dá para ver a emenda daqui.'")
    else Narrator.say("Qi abre o livro-caixa em uma página marcada com fita azul. O nome do seu irmão está riscado com uma linha só; logo abaixo, a dívida foi transferida para o identificador da sua cápsula, escrito com a mesma caneta.") end
    Character.say("qi", "De manhã eu atendo no armazém, atrás do guindaste azul. À noite eu atendo aqui. Se quiser trabalhar o desconto, eu tenho serviço que não precisa de assinatura.")
    Room.reveal("docas", "armazem")
    conf("qi", 1)
end)

Scene.create("intro_rex", function()
    limpa()
    if ativ("rex") == "no ringue" then
        Narrator.say("No ringue, um homem enorme sem camisa acaba de derrubar um lutador de metade do tamanho dele. Ele para, olha o adversário no chão, estende a mão e o levanta pelo braço. Depois dá as costas à plateia, que vaia, e vem direto para a grade.")
    else
        Narrator.say("Um homem enorme bate num saco de pancada pendurado numa corrente. A cada golpe o saco volta e ele o segura com o antebraço para começar de novo. Ele conta em voz alta e erra a conta; recomeça do um sem reclamar.")
    end
    Narrator.say("Ele tem uma orelha amassada, cicatrizes na cabeça raspada e os nós dos dedos mais largos do que os de qualquer pessoa que você já viu. Num banco, três tigelas de lámen vazias empilhadas.")
    Narrator.say("Rex pega um par de luvas do banco e joga na sua direção sem avisar.")
    Character.say("rex", "Segura.", { effect = "shake", color = "#ff6b72", speed = 16 })
    apresentar("rex")
    local c = Scene.choice({
        { id = "pegar", text = "Pegar as luvas.", say = fala_escolha("Pegar as luvas.") },
        { id = "devolver", text = "Jogar as luvas de volta.", say = fala_escolha("Jogar as luvas de volta.") },
        { id = "recusar", text = "Deixar as luvas caírem no chão.", say = fala_escolha("Deixar as luvas caírem no chão."), conditions = function() return tem("pavio_curto") or true end }
    })
    if c == "pegar" then
        Narrator.say("Você pega no ar. O couro é pesado e úmido. Ele aponta o queixo para o centro do tablado.")
        Character.say("rex", "Dois minutos. Só para eu ver como você respira.")
        Narrator.say("Você aguenta dois minutos. Ele bloqueia tudo com o antebraço e só dá um golpe, de leve, na costela. Dói por quarenta segundos.")
        Character.say("rex", "Você respira pela boca. Respira pelo nariz, senão eu quebro seu dente. Rex Quebra-Osso. Esse é o nome do cartaz, o resto é só Rex.")
        State.subtract("saude", 5)
        conf("rex", 2)
    elseif c == "devolver" then
        Narrator.say("Você joga as luvas de volta. Elas atingem o peito dele com um barulho seco. Ele não se mexe.")
        Character.say("rex", "Hm. Gostei. Eu jogo porque quero ver quem devolve.")
        conf("rex", 1)
    else
        Narrator.say("As luvas caem aos seus pés. O silêncio dura três segundos. Ele recolhe as luvas sem pressa e as pendura no ombro.")
        Character.say("rex", "Quem ensina a si mesmo não precisa de mim. Quem acha que não precisa, precisa mais.")
    end
end)

Scene.create("intro_lyra", function()
    limpa()
    if World.player_room() == "torre_helix" then
        Narrator.say("Uma mulher de blazer cinza atravessa o saguão seguida por quatro pessoas que anotam o que ela diz sem olhar para as próprias mãos. Ela não reduz o passo, mas para quando passa por você, a dois metros, e vira só a cabeça.")
        Character.say("lyra", "Visitante sem convite no meu saguão. Interessante.", { effect = "neon", color = "#bba8ff", speed = 18 })
    else
        Narrator.say("No balcão, uma mulher de blazer cinza e batom escuro lê num tablet fino. Uma taça de vinho tinto está parada ao lado, intocada, no mesmo ponto do balcão onde Bartô a colocou. Ela não olha para você. Fala com o tablet.")
        Character.say("lyra", "A mesa ao lado da minha está livre. Pode sentar. Ou pode ficar em pé e parecer nervoso. Os dois são úteis.", { effect = "neon", color = "#bba8ff", speed = 18 })
    end
    Narrator.say("Quando finalmente olha para você, tem olhos de quem já terminou de ler.")
    apresentar("lyra")
    Character.say("lyra", "Lyra Kane. Supervisão Operacional, Distrito 9. Helix.", { effect = "pulse", color = "#bba8ff", speed = 18 })
    Narrator.say("Ela vira um cartão preto de acesso sobre o balcão, com o logotipo para baixo.")
    local c = Scene.choice({
        { id = "porque", text = "'Por que está aqui?'", say = fala_escolha("'Por que está aqui?'") },
        { id = "helix", text = "'A Helix manda gente para lugares assim?'", say = fala_escolha("'A Helix manda gente para lugares assim?'") },
        { id = "blefe", text = "'Estou ocupado. Termina logo o que veio dizer.'", say = fala_escolha("'Estou ocupado. Termina logo o que veio dizer.'"), conditions = function() return tem("cara_de_pau") or tem("pavio_curto") end },
        { id = "sair", text = "Se afastar sem responder.", say = fala_escolha("Se afastar sem responder.") }
    })
    if c == "porque" then
        Character.say("lyra", "Eu observo. É o meu trabalho. Quem ouve primeiro, decide melhor.")
        conf("lyra", 1)
    elseif c == "helix" then
        Character.say("lyra", "A Helix não manda. A Helix sabe onde estão as pessoas e as pessoas vêm. Aqui eu só olho quem vem.")
        conf("lyra", 1)
    elseif c == "blefe" then
        Narrator.say("Um canto da boca dela sobe meio milímetro.")
        Character.say("lyra", "Gosto de gente que não pede desculpa. Você deve três mil a uma credora, e eu gastei isso em vinho este ano. Não vou oferecer nada. As pessoas se vendem melhor quando percebem sozinhas.", { effect = "neon", color = "#bba8ff", speed = 18 })
        conf("lyra", 2)
    else
        Narrator.say("Você se afasta. Atrás de você, o tablet continua aceso. Ela não vira a página.")
        return
    end
    Narrator.say("Lyra toca a borda da taça com um dedo, não bebe. O dedo deixa uma marca de umidade no vidro.")
end)

Scene.create("intro_zeca", function()
    limpa()
    Narrator.say("Algo se mexe num cano de esgoto dobrado contra a parede. Uma mão sai segurando um cartão laminado, depois um rosto magro de olheiras fundas e capuz xadrez. Ele olha para as duas pontas do beco antes de falar.")
    Character.say("zeca", "Psiu. Quem te mandou?", { effect = "glitch", color = "#a7efbf", speed = 16 })
    local ouviu_camelo = State.get("rumor_zeca_camelo")
    local ouviu_mira = State.get("rumor_zeca_mira")
    local texto_origem
    local fala_origem
    if ouviu_camelo then
        texto_origem = "'A camelô da feira disse que você tem o que não se vende em feira.'"
        fala_origem = "A camelô da feira disse que você tem o que não se vende em feira."
    elseif ouviu_mira then
        texto_origem = "'Mira Voss disse que você vende crachás.'"
        fala_origem = "Mira Voss disse que você vende crachás."
    else
        texto_origem = "'Encontrei seu esconderijo por acaso.'"
        fala_origem = "Encontrei seu esconderijo por acaso."
    end
    local c = Scene.choice({
        { id = "ninguem", text = "'Ninguém me mandou.'", say = fala_escolha("'Ninguém me mandou.'") },
        { id = "origem", text = texto_origem, say = fala_origem },
        { id = "sair", text = "Ir embora.", say = fala_escolha("Ir embora.") }
    })
    if c == "sair" then
        Character.say("zeca", "Boa. Você nunca me viu. Eu nunca te vi. Estamos quites.")
        return
    elseif c == "ninguem" then
        Character.say("zeca", "Ninguém. Ninguém é o melhor cliente. Não deixa registro, não conta para ninguém, não pergunta o preço duas vezes.")
    elseif ouviu_camelo then
        Character.say("zeca", "A velha dos óculos. Fala demais, mas fala para quem precisa. Eu te vendo o que você precisar, desde que me chame de Zeca e esqueça de onde veio.")
    elseif ouviu_mira then
        Character.say("zeca", "Mira Voss conhece mercadoria, não conhece meus horários. Se ela te mandou, é porque você procura uma entrada. Vamos ver se merece uma.")
    else
        Character.say("zeca", "Por acaso? Então você tem olhos melhores do que a maioria. O cano parece lixo para quem não sabe o que procurar.")
    end
    apresentar("zeca")
    Narrator.say("Ele abre o casaco. O forro é feito de bolsos: crachás plastificados, esferas cinzentas, saquinhos térmicos, três chips pretos em um estojo de óculos. Ele fecha o casaco antes de você contar.")
    Character.say("zeca", "Zeca Fantasma. Nome de nascença não vale nada, o de rua vale muito. Se você precisar de crachá, bobina, kit médico ou aperto de mão que ninguém vê, é comigo. E se precisar de lembrança, vem na quarta, na sexta ou no sábado, na hora do mercado.", { effect = "neon", color = "#a7efbf", speed = 18 })
    conf("zeca", 1)
end)

Scene.create("talk_ishi", function()
    limpa()
    apresentar("ishi")
    local q = State.get("q_gato")
    local a = ativ("ishi")
    if q == 0 then
        local topicos = {}
        if a == "regando o bonsai" then
            Narrator.say("Dona Ishi está ajoelhada diante do bonsai. Ela usa uma seringa sem agulha para molhar a terra sem encharcar as raízes. Ao perceber você, protege o vaso com a mão.")
            Character.say("ishi", "Pouca água, muita paciência. Se eu me apressar, ele morre. Se eu esquecer, também.", { effect = "wave", color = "#9bd8b0", speed = 20 })
            topicos = {
                { id = "elevador", txt = "Comentar o ruído do elevador.", fn = function() Character.say("ishi", "Você também ouve? Às três da manhã parece que alguém arrasta uma geladeira pelo teto.") end },
                { id = "bonsai", txt = "Perguntar como ela cuida do bonsai.", fn = function() Character.say("ishi", "Um pouco de água por vez. Kenji dizia que eu conversava mais com as plantas do que com ele.") end },
                { id = "cha", txt = "Perguntar pelo cheiro de chá.", fn = function() Character.say("ishi", "Folha de verdade. Minha filha mandava de Okinawa. Agora só tenho o que guardei.") end }
            }
        elseif a == "ouvindo rádio" then
            Narrator.say("Dona Ishi está sentada no banco do corredor, com o rádio de pilha apoiado no colo. Ela gira o botão de sintonia até a estática diminuir, mas não chega a desaparecer.")
            Character.say("ishi", "A estação muda de frequência sozinha desde a última chuva. Mesmo assim, gosto de deixar ligado.")
            topicos = {
                { id = "radio", txt = "Perguntar o que ela está ouvindo.", fn = function() Character.say("ishi", "A previsão do tempo, notícias velhas e, às vezes, uma voz lendo nomes de ruas que já não existem.") end },
                { id = "chiado", txt = "Perguntar por que o rádio chia.", fn = function() Character.say("ishi", "A antena está torta. Kenji dizia que consertava, mas sempre aparecia outra coisa para fazer.") end },
                { id = "cha", txt = "Perguntar pelo cheiro de chá.", fn = function() Character.say("ishi", "Folha de verdade. Minha filha mandava de Okinawa. Agora só tenho o que guardei.") end }
            }
        elseif a == "olhando a feira" then
            Narrator.say("Dona Ishi percorre as barracas sem tocar nas peças. Para diante de uma caixa de conectores, compara duas etiquetas e devolve uma peça ao lugar exato de onde veio.")
            Character.say("ishi", "Na feira, quem olha com pressa paga duas vezes. Quem olha com calma às vezes descobre que não precisa comprar nada.")
            topicos = {
                { id = "feira", txt = "Perguntar o que ela observa na feira.", fn = function() Character.say("ishi", "Peças de reposição, sementes e notícias. As notícias são a única coisa que não cabe numa sacola.") end },
                { id = "todos", txt = "Perguntar se ela vem à feira todos os dias.", fn = function() Character.say("ishi", "Quando posso. Os vendedores me conhecem; alguns conheceram Kenji também.") end },
                { id = "cha", txt = "Perguntar pelo cheiro de chá.", fn = function() Character.say("ishi", "Folha de verdade. Minha filha mandava de Okinawa. Agora só tenho o que guardei.") end }
            }
        else
            Narrator.say("Dona Ishi está junto das caixas de cultivo, ajeitando as folhas e retirando uma erva daninha com a ponta dos dedos. Ela limpa a terra da mão antes de cumprimentar você.")
            Character.say("ishi", "Planta não reclama quando a gente erra. Só para de crescer. Acho mais honesto que muita gente.")
            topicos = {
                { id = "horta", txt = "Perguntar se ela cuida da horta sozinha.", fn = function() Character.say("ishi", "Quase sempre. Kenji guardava sementes e dizia que um dia a gente teria um quintal de verdade.") end },
                { id = "sementes", txt = "Perguntar de onde vieram as plantas.", fn = function() Character.say("ishi", "As sementes eram do Kenji. A Helix chamava de material não autorizado. Eu chamo de comida.") end },
                { id = "cha", txt = "Perguntar pelo cheiro de chá.", fn = function() Character.say("ishi", "Folha de verdade. Minha filha mandava de Okinawa. Agora só tenho o que guardei.") end }
            }
        end
        menu(topicos, "Encerrar o assunto.")

        if a == "regando o bonsai" then
            Narrator.say("Ela deixa a seringa ao lado do vaso e pega uma pequena coleira azul, com uma das fivelas torta.")
        elseif a == "ouvindo rádio" then
            Narrator.say("Ela abaixa o volume do rádio e pega uma pequena coleira azul que estava dobrada ao lado do banco.")
        elseif a == "olhando a feira" then
            Narrator.say("Ela afasta uma sacola de peças e tira de dentro uma pequena coleira azul, com poeira presa na fivela.")
        elseif a == "cuidando da horta" then
            Narrator.say("Ela deixa o barbante sobre a caixa de cultivo e pega uma pequena coleira azul de dentro do bolso do colete.")
        else
            Narrator.say("Ela interrompe a tarefa por um instante e tira uma pequena coleira azul do bolso do colete.")
        end
        Character.say("ishi", "Eu queria te pedir uma coisa. Meu Mochi sumiu ontem. É um gato-drone, pequeno, orelha esquerda torta. Ele costuma voltar quando sente o cheiro do chá, mas não voltou.", { effect = "wave", color = "#9bd8b0", speed = 20 })
        local detalhe_texto, detalhe_fala
        if a == "regando o bonsai" then
            detalhe_texto, detalhe_fala = "Perguntar se alguém a ajuda com o bonsai.", "Você cuida desse bonsai sozinha?"
        elseif a == "ouvindo rádio" then
            detalhe_texto, detalhe_fala = "Perguntar se alguém já tentou consertar o rádio.", "Alguém já tentou consertar esse rádio?"
        elseif a == "olhando a feira" then
            detalhe_texto, detalhe_fala = "Perguntar se ela vem à feira todos os dias.", "Você vem à feira todos os dias?"
        else
            detalhe_texto, detalhe_fala = "Perguntar de quem são as sementes.", "De quem são essas sementes?"
        end
        local c = Scene.choice({
            { id = "ajudar", text = "Perguntar onde ele foi visto pela última vez e oferecer ajuda.", say = fala_escolha("Perguntar onde ele foi visto pela última vez e oferecer ajuda.") },
            { id = "nao", text = "Dizer que está sem tempo.", say = fala_escolha("Dizer que está sem tempo.") },
            { id = "detalhes", text = detalhe_texto, say = detalhe_fala }
        })
        if c == "ajudar" then
            State.set("q_gato", 1)
            Character.say("ishi", "Ontem ouvi um miado perto do duto de ventilação. Depois um barulho de metal vindo da rua baixa. Não sei se era ele.")
            Narrator.say("Ela entrega a você uma pequena peça azul que se soltou da coleira. Há poeira escura presa na dobradiça.")
        elseif c == "detalhes" then
            if a == "regando o bonsai" then
                Character.say("ishi", "Kenji me ensinou. Dizia que cuidar de uma árvore pequena era um jeito de lembrar que as coisas crescem devagar.")
            elseif a == "ouvindo rádio" then
                Character.say("ishi", "Um vizinho tentou trocar a antena. O rádio voltou a funcionar, mas a voz que eu queria ouvir não apareceu.")
            elseif a == "olhando a feira" then
                Character.say("ishi", "Venho quando preciso de alguma coisa e quando preciso sair um pouco do corredor. As duas coisas costumam acontecer juntas.")
            else
                Character.say("ishi", "As sementes eram do Kenji. Ele guardava cada uma em envelopes com a data e o nome da planta.")
            end
            ishi_retorna(a)
        else
            Character.say("ishi", "Entendo. A cidade é pesada demais para todos.")
            ishi_retorna(a)
        end
    elseif q == 1 then
        Character.say("ishi", "Nenhuma notícia do Mochi? Ele tem a orelha esquerda torta. Se brilhar azul, é ele.")
    elseif q == 2 then
        if Inventory.has("mochi") then
            Inventory.remove("mochi", 1)
            Narrator.say("Você abre o casaco. Mochi pula nos braços dela, ronronando como um motorzinho.")
            Character.say("ishi", "Meu bebê. Meu bebê!")
            Character.say("ishi", "Tome, o último chá verde de verdade que me restou. E uma dica: a escada de incêndio ao lado do elevador leva ao telhado. É meu segredo.")
            ganha(120)
            Inventory.give("cha_ishi", 1)
            State.set("q_gato", 3)
            State.add("rep_rua", 1)
            Event.emit("gato_devolvido", {})
        else
            Character.say("ishi", "Achou? Cadê ele?")
        end
    else
        if a == "ouvindo rádio" then
            Character.say("ishi", "O rádio hoje só fala de chuva e de dívida. Tome cuidado lá fora, " .. trat() .. ".")
        elseif a == "regando o bonsai" then
            Character.say("ishi", "Até o bonsai parece mais tranquilo hoje. Mochi dorme no meu colo quando volto para casa.")
        elseif a == "olhando a feira" then
            Character.say("ishi", "Na feira, todo mundo pergunta pelo gato. Ninguém admite que sente falta dele, mas perguntam.")
        elseif a == "cuidando da horta" then
            Character.say("ishi", "Mochi gosta de dormir entre as caixas de cultivo. Agora as plantas crescem sem ele derrubar tudo.")
        else
            Character.say("ishi", "Mochi dorme no meu colo agora. A casa voltou a ter som de gente.")
        end
    end
end)

local function situacao_entrega(id)
    local sala = Character.room(id)
    local atividade = ativ(id)
    if type(atividade) == "string" and atividade:find("dormindo", 1, true) then
        if id == "sal" then return "Sal está dormindo em pé na clínica." end
        if id == "pixel" then return "Pixel dormiu sobre o teclado no NetHaven." end
    end
    if id == "sal" then
        if sala == "clinica" then return "Sal está na clínica, atendendo." end
        if sala == "bar_sinapse" then return "Sal foi ao Bar Sinapse para beber depois do plantão." end
        if sala == "arena" then return "Sal está na arena, remendando os lutadores." end
    elseif id == "pixel" then
        if sala == "nexus" then return "Pixel está no NetHaven, trabalhando nos terminais." end
        if sala == "telhado" then return "Pixel está no telhado, observando as luzes da Torre." end
        if sala == "refugio" then return "Pixel está no refúgio, trabalhando nos servidores da Rede Livre." end
    elseif id == "rex" then
        if sala == "noodle_bar" then return "Rex está no Lámen, fazendo uma pausa para comer." end
        if sala == "clinica" then return "Rex está na clínica, tratando os cortes com Sal." end
        if sala == "vestiario" then return "Rex está no vestiário, enfaixando as mãos." end
        if sala == "arena" then
            if atividade == "no ringue" then return "Rex está no ringue." end
            return "Rex está treinando na arena."
        end
    end
    local nomes = {
        corredor = "corredor", feira = "feira", telhado = "telhado", nexus = "NetHaven",
        clinica = "clínica", bar_sinapse = "Bar Sinapse", arena = "arena",
        vestiario = "vestiário", noodle_bar = "Lámen do Taro", docas = "Docas",
        armazem_qi = "armazém de Qi", becos = "becos", mercado_noturno = "Mercado Noturno"
    }
    return nome_de(id) .. " está no " .. (nomes[sala] or "outro ponto da cidade") .. "."
end

Scene.create("talk_taro", function()
    limpa()
    apresentar("taro")
    local q = State.get("q_taro")
    if q == 0 then
        Narrator.say("Taro termina de servir duas tigelas. Uma mulher paga em moedas; o garoto de capuz no canto recebe a dele sem abrir a carteira. Taro limpa as mãos no avental e olha para você.")
        Character.say("taro", "Você já reparou que ninguém olha para quem está comendo? É a única hora em que a avenida deixa a gente em paz.", { effect = "wave", color = "#ffbd66", speed = 18 })
        local papo = Scene.choice({
            { id = "comida", text = "Perguntar por que ele serve o garoto de graça.", say = fala_escolha("Perguntar por que ele serve o garoto de graça.") },
            { id = "gato", text = "Perguntar pelo gato holográfico no letreiro.", say = fala_escolha("Perguntar pelo gato holográfico no letreiro.") },
            { id = "turno", text = "Perguntar se ele sempre trabalha sozinho.", say = fala_escolha("Perguntar se ele sempre trabalha sozinho.") }
        })
        if papo == "comida" then
            Character.say("taro", "Aquele garoto de capuz, ali no canto, é o Juca. A mãe dele usa Bruma. Tem dias em que ela lembra que tem filho, tem dias em que não. O garoto não tem culpa.")
            State.set("conhece_juca", true)
        elseif papo == "gato" then
            Character.say("taro", "Era para ser um gato inteiro. O fornecedor cortou custo e entregou sem uma pata. Meu pai mandou deixar assim.")
        else
            Character.say("taro", "Meu irmão fazia a noite. Foi para a Helix e nunca voltou. O aluguel não espera por luto.")
        end
        Narrator.say("Um pedido apita na cozinha. Taro desliga o aviso com o cotovelo, mas não se mexe para pegar a bandeja.")
        local destinos = situacao_entrega("sal") .. " " .. situacao_entrega("pixel") .. " " .. situacao_entrega("rex")
        Character.say("taro", "Preciso levar três tigelas. " .. destinos .. " Você pode levar para eles?")
        local c = Scene.choice({
            { id = "sim", text = "Aceitar as entregas.", say = fala_escolha("Aceitar as entregas.") },
            { id = "perguntar", text = "Perguntar quanto ele paga e por que não manda um drone.", say = fala_escolha("Perguntar quanto ele paga e por que não manda um drone.") },
            { id = "nao", text = "Recusar por enquanto.", say = fala_escolha("Recusar por enquanto.") }
        })
        if c == "sim" then
            Inventory.give("tigela", 3)
            State.set("q_taro", 1)
            Character.say("taro", "Valeu. As tampas estão bem fechadas. Se derramar no caminho, eu desconto do pagamento.")
            Narrator.say("(Missão: As entregas do Taro. Leve tigelas ao Doc Sal, Pixel e Rex.)")
        else
            Character.say("taro", "Tá bom, tá bom. Mas a oferta continua de pé!")
        end
    elseif q == 1 then
        Character.say("taro", "Faltam " .. (3 - State.get("entregas")) .. " entregas. " .. situacao_entrega("sal") .. " " .. situacao_entrega("pixel") .. " " .. situacao_entrega("rex"))
    elseif q == 2 then
        Character.say("taro", "Todas entregues? Você é um herói do vapor!")
        ganha(200)
        State.set("q_taro", 3)
        State.set("taro_amigo", true)
        State.add("rep_rua", 1)
        Character.say("taro", "E daqui pra frente, lámen pra você custa só 8 ¢. Família não paga preço cheio.")
    else
        Character.say("taro", "Tigela fresquinha quando quiser, " .. g("amigo", "amiga", nome_conhecido("taro", "meu bem")) .. "!")
    end
end)

Scene.create("talk_sal", function()
    limpa()
    local primeira = not State.get("apresentou_sal")
    local sala = World.player_room()
    apresentar("sal")
    entrega("entregou_sal")
    if primeira and sala ~= "clinica" then
        Character.say("sal", "Doc Sal. Minha clínica fica na Avenida Baixa. Hoje estou fora do consultório, então nada de cirurgia improvisada.", { effect = "pulse", color = "#ffb58a", speed = 18 })
    elseif sala == "bar_sinapse" then
        Character.say("sal", "Hoje eu não vim atender. Vim beber até a cidade parar de doer. Se estiver sangrando, amanhã eu cobro mais caro.", { effect = "pulse", color = "#ffb58a", speed = 18 })
    elseif sala == "arena" then
        Character.say("sal", "Se algum lutador abrir a cabeça, me chama. Hoje só estou remendando quem insiste em voltar ao ringue.", { effect = "pulse", color = "#ffb58a", speed = 18 })
    else
        Character.say("sal", "Quer carne nova ou só remendo? Aqui na clínica, pelo menos, eu tenho luz e instrumentos.", { effect = "pulse", color = "#ffb58a", speed = 18 })
    end
    while true do
        local c = Scene.choice({
            { id = "reflexos", text = "Instalar Reflexos Sinápticos (200 ¢).", say = fala_escolha("Instalar Reflexos Sinápticos (200 ¢)."),
              conditions = function() return sala == "clinica" and not State.get("implante_reflexos") and State.get("creditos") >= 200 end },
            { id = "neuro", text = "Instalar Neuroport (600 ¢ + Bobina Neural).", say = fala_escolha("Instalar Neuroport (600 ¢ + Bobina Neural)."),
              conditions = function() return sala == "clinica" and not State.get("implante_neuroport") and State.get("creditos") >= 600 and Inventory.has("bobina_neural") end },
            { id = "papo", text = "Perguntar o que Sal acha da cidade.", say = fala_escolha("Perguntar o que Sal acha da cidade.") },
            { id = "bebida", text = "Perguntar por que ele está bebendo.", say = fala_escolha("Perguntar por que ele está bebendo."), conditions = function() return sala == "bar_sinapse" end },
            { id = "sair", text = "Sair.", say = fala_escolha("Sair.") }
        })
        if c == "sair" then break end
        if c == "reflexos" then
            State.subtract("creditos", 200)
            Narrator.say("Sal enfia uma agulha na sua nuca. O mundo fica um décimo mais lento. (-200 ¢)")
            Scene.delay(120)
            State.set("implante_reflexos", true)
            State.subtract("saude", 10)
            Narrator.say("(Implante: Reflexos Sinápticos. Lutas e fugas ficam mais fáceis.)")
        elseif c == "neuro" then
            State.subtract("creditos", 600)
            Inventory.remove("bobina_neural", 1)
            Narrator.say("Sal solta um assobio baixo. 'Esse porto aceita qualquer coisa. Qualquer.' (-600 ¢)")
            Scene.delay(240)
            State.set("implante_neuroport", true)
            State.subtract("saude", 20)
            Narrator.say("(Implante: Neuroport. Você sente a rede como uma segunda pele.)")
        elseif c == "bebida" then
            Character.say("sal", "Porque hoje perdi dois pacientes e salvei um. Não existe dose que faça a conta fechar. Amanhã eu volto para a clínica.", { effect = "pulse", color = "#ffb58a", speed = 18 })
        else
            Character.say("sal", "O Distrito 9 está cheio de gente doente. Eu só costuro quem ainda chega andando.")
        end
    end
end)

Scene.create("talk_pixel", function()
    limpa()
    local primeira = not State.get("apresentou_pixel")
    local sala = World.player_room()
    apresentar("pixel")
    entrega("entregou_pixel")
    if primeira and sala == "telhado" then
        Character.say("pixel", "Pixel. É o nome que uso na rede. Aqui em cima eu só observo as luzes; para mexer nos sistemas, prefiro o NetHaven lá embaixo.", { effect = "glitch", color = "#6fe3ff", speed = 16 })
    elseif sala == "telhado" then
        Character.say("pixel", "As luzes da Torre piscam em padrões. Não trouxe um terminal para cá, então hoje é só conversa.", { effect = "wave", color = "#6fe3ff", speed = 18 })
    else
        Character.say("pixel", "E aí? Precisa de código, de sorte ou de uma mente melhor?", { effect = "glitch", color = "#6fe3ff", speed = 16 })
    end
    if State.get("q_main") >= 3 then
        if sala == "refugio" then
            Character.say("pixel", "Chegou. Aqui a Rede Livre mantém os servidores longe das câmeras da Helix. Não é bonito, mas é nosso.", { effect = "neon", color = "#6fe3ff", speed = 18 })
        else
            Character.say("pixel", "Se a Voz te escolheu, o bueiro nos becos leva ao nosso refúgio. Procure o desenho de um olho riscado.", { effect = "neon", color = "#6fe3ff", speed = 18 })
        end
    end
    while true do
        local custo = (State.get("hacker") + 1) * 100
        local c = Scene.choice({
            { id = "aula", text = "Aprender hacking (" .. custo .. " ¢).",
              say = fala_escolha("Vou aprender hacking por " .. custo .. " créditos."),
              conditions = function() return sala == "nexus" and State.get("hacker") < 3 and State.get("creditos") >= custo end },
            { id = "decifrar", text = "Decifrar um chip cifrado (150 ¢, ou grátis se você já hackeia).", say = fala_escolha("Decifrar um chip cifrado (150 ¢, ou grátis se você já hackeia)."),
              conditions = function() return sala == "nexus" and State.get("q_main") == 2 and Inventory.has("chip_cifrado") and (State.get("hacker") >= 1 or State.get("creditos") >= 150) end },
            { id = "papo", text = "Conversar.", say = fala_escolha("Conversar.") },
            { id = "sair", text = "Sair.", say = fala_escolha("Sair.") }
        })
        if c == "sair" then break end
        if c == "aula" then
            State.subtract("creditos", custo)
            Narrator.say("Pixel puxa uma cadeira diante de um terminal livre e desfila atalhos de teclado como feitiços. (-" .. custo .. " ¢)", { effect = "glitch", color = "#6fe3ff", speed = 18 })
            Scene.delay(90)
            State.add("hacker", 1)
            Narrator.say("(Hacking nível " .. State.get("hacker") .. ".)")
        elseif c == "decifrar" then
            if State.get("hacker") < 1 then State.subtract("creditos", 150) Narrator.say("(-150 ¢)") end
            Narrator.say("Pixel espeta o chip num terminal. Linhas verdes cascateiam pelas telas.")
            Scene.delay(90)
            Narrator.say("A tela escurece. Uma voz de mulher, rouca, enche a sala: 'Quem está aí? Se for da Helix, desligue agora.'")
            Character.say("pixel", "Merda. Isso não é um arquivo. É alguém.", { effect = "glitch", color = "#6fe3ff", speed = 16 })
            Narrator.say("O chip contém o núcleo de memória do projeto ORFEU: uma IA, presa num laboratório no subnível 9 da Torre Helix.")
            Narrator.say("A voz se apresenta como 'Vesper'. Pede ajuda. Depois some.", { effect = "neon", color = "#75d4ff", speed = 20 })
            State.set("q_main", 3)
            State.add("vozes", 1)
            Room.reveal("becos", "bueiro")
            Narrator.say("(Missão atualizada: Infiltrar o laboratório. Você pode usar crachá falso, apagão, EMP, hacking ou a própria Voz. Nova saída: o bueiro nos becos.)")
        else
            Character.say("pixel", "A Helix acha que prevê o futuro. A gente só joga o dado antes. Às vezes dá certo.")
        end
    end
end)

Scene.create("talk_mira", function()
    limpa()
    local primeira = not State.get("apresentou_mira")
    local sala = World.player_room()
    apresentar("mira")
    if primeira and sala ~= "bar_sinapse" then
        Character.say("mira", "Mira Voss. Você ainda não me conhece, mas eu já conferi seu contrato com Qi. Não confunda isso com amizade; é só pesquisa.", { effect = "neon", color = "#e8bbff", speed = 18 })
    end
    local q = State.get("q_main")
    if State.get("traiu_mira") then
        Narrator.say("Mira te encara, sem pestanejar. O bar inteiro parece prender a respiração.")
        Character.say("mira", "Você sabe o que fez. Saia.")
        return
    end
    if q == 0 then
        if primeira and sala ~= "bar_sinapse" then
            Character.say("mira", "Já que estamos frente a frente: um mensageiro da Helix morreu nas Docas esta madrugada. Carregava um chip chamado ORFEU.", { effect = "pulse", color = "#e8bbff", speed = 18 })
        else
            Character.say("mira", "Você veio. Boa. Escuta: um mensageiro da Helix morreu nas Docas esta madrugada. Carregava um chip chamado ORFEU.", { effect = "pulse", color = "#e8bbff", speed = 18 })
        end
        Character.say("mira", "Quero esse chip antes que os cães da Helix o encontrem. Pago 1.500 ¢. Adianto 500 agora.", { effect = "pulse", color = "#e8bbff", speed = 18 })
        local c = Scene.choice({
            { id = "aceitar", text = "Aceito. Onde começo?", say = fala_escolha("Aceito. Onde começo?") },
            { id = "perguntar", text = "O que é ORFEU?", say = fala_escolha("O que é ORFEU?") },
            { id = "recusar", text = "Não é minha praia.", say = fala_escolha("Não é minha praia.") }
        })
        if c == "perguntar" then
            Character.say("mira", "Se eu soubesse, não pagaria tanto. Só sei que a Helix mataria por ele. E que alguém de lá quer que ele vaze.")
            c = Scene.choice({
                { id = "aceitar", text = "Aceito. Onde começo?", say = fala_escolha("Aceito. Onde começo?") },
                { id = "recusar", text = "Ainda assim, não.", say = fala_escolha("Ainda assim, não.") }
            })
        end
        if c == "aceitar" then
            State.set("q_main", 1)
            State.set("mira_conhece", true)
            ganha(500)
            Character.say("mira", "Docas. Contêineres do lado sul. Ache o chip e traga pra mim, ou para o Pixel, no NetHaven. Ele sabe abrir.")
            Narrator.say("(Missão principal: Ache o chip ORFEU nas Docas.)")
        else
            Character.say("mira", "Então esqueça que me viu. Mas a oferta fica de pé por mais um dia.")
        end
    elseif q == 1 then
        Character.say("mira", "Nas Docas, contêineres do lado sul. Vá preparado.")
    elseif q == 2 then
        Character.say("mira", "Achou? Leve ao Pixel, no NetHaven. Ele decifra por você.")
    elseif q == 3 then
        Character.say("mira", "Então é uma IA? Lena Orfeu... Vesper... Ouça: a Torre tem cinco entradas, mas nenhuma é fácil. Zeca vende crachás. O apagão do dia 4 desliga as câmeras.", { effect = "pulse", color = "#e8bbff", speed = 18 })
        State.set("rumor_zeca", true)
        State.set("rumor_zeca_mira", true)
    elseif q == 4 then
        Character.say("mira", "Está lá dentro? Respire. Pegue o núcleo e saia. A Helix não vai perdoar.")
    elseif q == 5 then
        Character.say("mira", "Você conseguiu. Agora a pergunta é: o que faz com o que tem nas mãos? Sugiro o refúgio, no bueiro dos becos. Eles saberão o que fazer.")
    else
        Character.say("mira", "O que passou, passou. Eu agora só quero um café e uma semana tranquila.")
    end
end)

Scene.create("talk_qi", function()
    limpa()
    local primeira = not State.get("apresentou_qi")
    local sala = World.player_room()
    apresentar("qi")
    if primeira and sala == "armazem_qi" then
        Character.say("qi", "Madame Qi. É assim que me chamam quando não estão lendo meu contrato. Dívida: " .. State.get("divida") .. " ¢. Prazo: domingo.", { effect = "pulse", color = "#ffbd66", speed = 18 })
    else
        Character.say("qi", "Meu " .. trat() .. ". Dívida: " .. State.get("divida") .. " ¢. Prazo: domingo.", { effect = "pulse", color = "#ffbd66", speed = 18 })
    end
    local c = Scene.choice({
        { id = "pagar", text = "Pagar parte da dívida.", say = fala_escolha("Pagar parte da dívida."), conditions = function() return State.get("creditos") >= 50 and State.get("divida") > 0 end },
        { id = "trabalho", text = "Perguntar sobre trabalhos.", say = fala_escolha("Perguntar sobre trabalhos.") },
        { id = "sair", text = "Sair.", say = fala_escolha("Sair.") }
    })
    if c == "pagar" then Scene.call("pagar_qi")
    elseif c == "trabalho" then
        local lugar = sala == "armazem_qi" and "neste armazém" or "nas docas"
        Character.say("qi", "Faço descontos para quem me serve. Use a opção 'trabalho sujo' " .. lugar .. ". Uma vez por dia. Sempre há um risco.", { effect = "pulse", color = "#ffbd66", speed = 18 })
    end
end)

Scene.create("trabalho_qi", function()
    limpa()
    State.set("qi_dia", Time.day())
    Narrator.say("Qi te entrega um pacote lacrado e um endereço. Você carrega a caixa por vielas escuras, sentindo algo se mexer dentro.")
    local roll = math.random(1, 10) + State.get("treino") + (State.get("implante_reflexos") and 3 or 0) - State.get("cansaco")
    if roll >= 8 then
        Narrator.say("Entrega feita sem testemunhas. Qi desconta o valor na sua dívida.")
        State.subtract("divida", 250)
        Narrator.say("(Dívida -250 ¢. Restante: " .. State.get("divida") .. " ¢.)")
        calor(1)
    else
        Narrator.say("Alguém te segue. Você corre, derruba a caixa, apanha. Mas a entrega chega, torta.")
        State.subtract("divida", 100)
        Narrator.say("(Dívida -100 ¢.)")
        dano(20)
        calor(1)
    end
end)

Scene.create("talk_rex", function()
    limpa()
    local primeira = not State.get("apresentou_rex")
    local sala = World.player_room()
    local atividade = ativ("rex")
    apresentar("rex")
    entrega("entregou_rex")
    if sala == "noodle_bar" then
        Character.say("rex", primeira and "Rex. Não vim para brigar. Vim comer antes que o Taro feche a panela. Quer conversar ou vai ficar olhando minha tigela?" or "Não vim para brigar. Vim comer antes que o Taro feche a panela. Quer conversar ou vai ficar olhando minha tigela?", { effect = "shake", color = "#ff6b72", speed = 16 })
    elseif sala == "clinica" then
        Character.say("rex", primeira and "Rex. Sal está cuidando dos meus cortes. Se veio falar da rinha, fala baixo; ele odeia quando eu volto para lá antes de fechar os pontos." or "Sal está cuidando dos meus cortes. Se veio falar da rinha, fala baixo; ele odeia quando eu volto para lá antes de fechar os pontos.", { effect = "shake", color = "#ff6b72", speed = 16 })
    elseif sala == "vestiario" then
        Character.say("rex", primeira and "Rex. Estou enfaixando as mãos. Não encosta nas luvas molhadas. Quer saber da luta de hoje?" or "Estou enfaixando as mãos. Não encosta nas luvas molhadas. Quer saber da luta de hoje?", { effect = "shake", color = "#ff6b72", speed = 16 })
    elseif not State.get("rex_amigo") then
        Character.say("rex", primeira and "Rex. Aqui é onde treino. Quer aprender a aguentar um golpe ou só veio assistir?" or "Quer ser respeitado? Enfrente alguém no ringue. Ou treine comigo, se tiver estômago.", { effect = "shake", color = "#ff6b72", speed = 16 })
    else
        Character.say("rex", "Fala, " .. g("campeão", "campeã", nome_conhecido("rex", "meu bem")) .. ". A sua cara no ringue vende ingresso.", { effect = "shake", color = "#ff6b72", speed = 16 })
    end
    local c = Scene.choice({
        { id = "treino", text = "Treinar com Rex (1 h, vai doer).", say = fala_escolha("Treinar com Rex (1 h, vai doer)."),
          conditions = function() return sala == "arena" and atividade == "treinando" and State.get("treino") < 3 and State.get("saude") > 30 end },
        { id = "papo", text = "Perguntar sobre a rinha.", say = fala_escolha("Perguntar sobre a rinha.") },
        { id = "sair", text = "Sair.", say = fala_escolha("Sair.") }
    })
    if c == "treino" then
        Narrator.say("Rex te enfia no chão duas vezes antes de você acertar um golpe.")
        Scene.delay(60)
        State.add("treino", 1)
        State.set("rex_amigo", true)
        dano(8)
        Narrator.say("(Treino " .. State.get("treino") .. "/3. Você luta melhor.)")
    elseif c == "papo" then
        Character.say("rex", "A rinha começa às 22h, todo dia. Entrar custa 50 ¢. Ganhar paga 300. Perder custa dente. Apostar dá menos risco, mas depende da sorte.")
    end
end)

Scene.create("talk_zeca", function()
    limpa()
    local primeira = not State.get("apresentou_zeca")
    local sala = World.player_room()
    apresentar("zeca")
    if primeira and State.get("rumor_zeca_camelo") then
        Character.say("zeca", "A velha dos óculos falou de mim? Ela sabe que não gosto de visita anunciada. Mas já que veio, vamos ao que interessa.", { effect = "glitch", color = "#a7efbf", speed = 16 })
    elseif primeira and State.get("rumor_zeca_mira") then
        Character.say("zeca", "Mira Voss te passou meu nome? Ela conhece meus produtos, não meus horários. Vamos ver o que você procura.", { effect = "glitch", color = "#a7efbf", speed = 16 })
    elseif primeira and sala == "mercado_noturno" then
        Character.say("zeca", "Zeca Fantasma. No mercado eu monto banca; nos becos eu negocio o que não pode ter etiqueta. Você chegou por conta própria?", { effect = "glitch", color = "#a7efbf", speed = 16 })
    else
        Character.say("zeca", "Psiu. Bom te ver. Ou nem tanto. Preciso de uma coisa, tenho de outra.", { effect = "glitch", color = "#a7efbf", speed = 16 })
    end
    while true do
        local c = Scene.choice({
            { id = "cracha", text = "Comprar crachá falso da Helix (300 ¢).", say = fala_escolha("Comprar crachá falso da Helix (300 ¢)."),
              conditions = function() return not Inventory.has("cracha_falso") and State.get("creditos") >= 300 end },
            { id = "bobina", text = "Comprar bobina neural (150 ¢).", say = fala_escolha("Comprar bobina neural (150 ¢)."),
              conditions = function() return not Inventory.has("bobina_neural") and not State.get("implante_neuroport") and State.get("creditos") >= 150 end },
            { id = "emp", text = "Comprar granada EMP (200 ¢).", say = fala_escolha("Comprar granada EMP (200 ¢)."),
              conditions = function() return not Inventory.has("pulso_emp") and State.get("creditos") >= 200 end },
            { id = "kit", text = "Comprar kit médico (60 ¢).", say = fala_escolha("Comprar kit médico (60 ¢)."), conditions = function() return State.get("creditos") >= 60 end },
            { id = "sair", text = "Sair.", say = fala_escolha("Sair.") }
        })
        if c == "sair" then break end
        if c == "cracha" then State.subtract("creditos", 300) Inventory.give("cracha_falso", 1) Narrator.say("Zeca desliza o crachá pela manga. 'Nunca vi você.' (-300 ¢)")
        elseif c == "bobina" then State.subtract("creditos", 150) Inventory.give("bobina_neural", 1) Narrator.say("Uma bobina quente, num saquinho. (-150 ¢)")
        elseif c == "emp" then State.subtract("creditos", 200) Inventory.give("pulso_emp", 1) Narrator.say("Uma esfera cinza e pesada. 'Aperte e corra.' (-200 ¢)")
        elseif c == "kit" then State.subtract("creditos", 60) Inventory.give("kit_medico", 1) Narrator.say("Um kit de campo. 'Nunca se sabe.' (-60 ¢)") end
    end
end)

Scene.create("talk_lyra", function()
    limpa()
    local primeira = not State.get("apresentou_lyra")
    apresentar("lyra")
    local aqui_torre = World.player_room() == "torre_helix"
    if primeira and not aqui_torre then
        Character.say("lyra", "Lyra Kane. Supervisão Operacional da Helix. Não se preocupe: eu já sei o suficiente sobre você para esta conversa.", { effect = "neon", color = "#bba8ff", speed = 18 })
    end
    if aqui_torre then
        Character.say("lyra", "Visitante sem convite no meu saguão. Interessante.", { effect = "neon", color = "#bba8ff", speed = 18 })
    else
        Character.say("lyra", "Aquela mesa está livre. Sente. Ou fique em pé e pareça nervoso.", { effect = "neon", color = "#bba8ff", speed = 18 })
    end
    local c = Scene.choice({
        { id = "orfeu", text = "Perguntar discretamente sobre ORFEU.", say = fala_escolha("Perguntar discretamente sobre ORFEU."), conditions = function() return State.get("q_main") >= 1 end },
        { id = "vender", text = "Oferecer informações sobre Mira (800 ¢).", say = fala_escolha("Oferecer informações sobre Mira (800 ¢)."),
          conditions = function() return State.get("mira_conhece") and not State.get("traiu_mira") end },
        { id = "nucleo", text = "Oferecer o núcleo ORFEU (final corporativo).", say = fala_escolha("Oferecer o núcleo ORFEU (final corporativo)."),
          conditions = function() return State.get("q_main") == 5 and Inventory.has("nucleo_orfeu") end },
        { id = "sair", text = "Sair.", say = fala_escolha("Sair.") }
    })
    if c == "orfeu" then
        Character.say("lyra", "Nunca ouvi esse nome. Mas se ouvir, seria um erro de carreira você ter ouvido primeiro.")
        State.add("heat", 1)
    elseif c == "vender" then
        Character.say("lyra", "Você é prático. Gosto disso.")
        State.set("traiu_mira", true)
        State.add("rep_corp", 3)
        State.subtract("rep_rua", 2)
        ganha(800)
        Narrator.say("(Você traiu Mira. As portas da rua ficam um pouco mais frias.)")
    elseif c == "nucleo" then
        Scene.jump("fim_vender")
    end
end)

-- ============================================================================
-- CENAS: MISSÃO PRINCIPAL E EVENTOS
-- ============================================================================

Scene.create("docas_busca", function()
    limpa()
    Narrator.say("Contêineres empilhados como dentes tortos. Cheiro de metal quente e sangue seco.")
    local roll = math.random(1, 10) + (State.get("implante_reflexos") and 2 or 0) - State.get("cansaco")
    if roll >= 6 then
        Narrator.say("Atrás de um contêiner aberto, um corpo de terno branco. Os dedos ainda seguram uma maleta quebrada.")
        Narrator.say("Dentro, um chip preto, quente, logotipo da Helix. Você o guarda no bolso interno.")
        Inventory.give("chip_cifrado", 1)
        State.set("q_main", 2)
        calor(1)
        Narrator.say("(Missão atualizada: Leve o chip ao Pixel no NetHaven, ou a Mira.)")
    else
        Narrator.say("Uma silhueta se move no escuro. Algo estala. Você rola para trás, mas leva um golpe de cano.")
        dano(15)
        Narrator.say("Quem quer que seja, fugiu. O corpo ainda está por aí. Tente de novo.")
    end
end)

Scene.create("hack_anuncios", function()
    limpa()
    Narrator.say("Você se conecta ao terminal. A rede de anúncios é um labirinto de ofertas, spyware e promessas falsas.")
    local roll = math.random(1, 10) + State.get("hacker") * 2
    if roll >= 13 then
        Narrator.say("Você desvia centavos de milhares de contas e os agrupa em um buraco negro só seu.")
        ganha(120)
    elseif roll >= 8 then
        Narrator.say("A invasão funciona, mas um alarme dispara. Você sai com a metade do butim.")
        ganha(50)
        calor(1)
    else
        Narrator.say("Um contra-ICE explode na sua cara. Faíscas no teclado. Você perde um dente de leite emocional.")
        dano(10)
        calor(1)
    end
end)

Scene.create("voz_terminal", function()
    limpa()
    Narrator.say("A tela do terminal anônimo pisca. Texto verde, uma palavra por vez.")
    Character.say("pixel", "(de longe) Cuidado com essa coisa!")
    local falas = {
        "Você ainda está aí? Lembro vagamente de quem eu fui. Lena. E de quem deixei de ser.",
        "A Helix me usa para decidir quem apaga as luzes. Preciso sair daqui antes que eu aprenda a gostar.",
        "Eu não quero poder. Quero silêncio. Ou companhia. Ainda não sei qual.",
        "Se você me tirar de lá, prometo uma coisa: eu escolho, com você, para onde vamos.",
        "Obrigada por ouvir. Ninguém ouve máquinas. Nem pessoas, ultimamente."
    }
    local n = math.min(State.get("vozes") + 1, 5)
    Narrator.say(falas[n])
    if State.get("vozes") < 5 then State.set("vozes", n) end
    Narrator.say("(Vozes ouvidas: " .. State.get("vozes") .. "/5.)")
end)

Scene.create("voz_msg", function()
    limpa()
    local falas = {
        "No meio do sono, o painel de LED da cápsula pisca em morse. 'Você me ouve?'",
        "O LED sussurra em tom de contralto: 'A Helix me chama de ORFEU. Eu me lembro de ser Lena.'",
        "Você acorda com a sensação de ter conversado a noite toda. O painel escreve: 'Obrigada por ficar.'",
        "A tela mostra uma única linha: 'A Torre tem um elevador que só eu conheço. Chame quando for a hora.'",
        "O LED pisca três vezes. Depois, silêncio absoluto. Parece despedida."
    }
    local n = math.min(State.get("vozes") + 1, 5)
    Narrator.say(falas[n])
    State.set("vozes", n)
    Narrator.say("(Vozes ouvidas: " .. State.get("vozes") .. "/5.)")
end)

Scene.create("lobby_cracha", function()
    limpa()
    local roll = math.random(1, 10) + State.get("rep_corp")
    if roll >= 5 then
        abre_lab("O segurança escaneia o crachá, franze a testa, e deixa passar. Um pequeno milagre da impressão 3D.")
    else
        Narrator.say("O segurança hesita, olha o crachá, olha você. O alarme silencioso dispara.")
        calor(2)
        Narrator.say("Você sai antes de ser algemado. Tente outra abordagem.")
    end
end)

Scene.create("lobby_servico", function()
    limpa()
    Narrator.say("As câmeras estão apagadas. Uma porta de serviço sem tranca, vigiada por um segurança sonolento.")
    local roll = math.random(1, 10) + (State.get("implante_reflexos") and 2 or 0)
    if roll >= 4 then
        abre_lab("Você se esgueira, desvia, passa pelo corredor de lixo e chega ao elevador do laboratório.")
    else
        Narrator.say("O segurança tropeça em você no escuro. Dois socos e uma fuga.")
        dano(12)
        calor(1)
    end
end)

Scene.create("lobby_emp", function()
    limpa()
    Inventory.remove("pulso_emp", 1)
    Narrator.say("Você aperta a granada. Um estalo seco. Todas as luzes morrem. As câmeras viram cegos.")
    abre_lab("Você usa os seis segundos de escuridão para chegar ao elevador, que ainda tem bateria de emergência.")
    calor(2)
end)

Scene.create("lobby_hack", function()
    limpa()
    Narrator.say("O painel de acesso é cheio de camadas. Você sente a ponta dos dedos formigarem enquanto mergulha na rede da Torre.")
    local roll = math.random(1, 10) + State.get("hacker") * 2
    if roll >= 9 then
        abre_lab("Uma sequência final de comandos, e as portas do elevador se abrem, dóceis como cães treinados.")
    else
        Narrator.say("Um contra-ICE ruge. Você arranca o cabo antes de fritar o cérebro, mas o alarme soa.")
        dano(10)
        calor(1)
    end
end)

Scene.create("lobby_voz", function()
    limpa()
    Narrator.say("Você abre o comunicador e sussurra: 'Vesper. Preciso de uma porta.'")
    Narrator.say("Um segundo de silêncio. Depois, nos alto-falantes escondidos da Torre, uma única nota musical.")
    abre_lab("Sem alarmes, sem câmeras, sem segurança. As portas do elevador se abrem como quem estende uma mão.")
end)

Scene.create("lab_entrada", function()
    limpa()
    Theme.set({accent="#b44cff",accent2="#ff2bd6",glow="#b44cff",glow2="#ff2bd6"})
    State.set("q_main", 4)
    Narrator.say("O elevador desce em silêncio. Quando as portas se abrem, o ar muda de textura, mais denso, quase vivo.")
    Narrator.say("No centro da sala, o núcleo ORFEU flutua em um cilindro de luz azul.")
    Narrator.say("Uma voz suave, mas sem eco: 'Você veio.'")
    Narrator.say("(Missão atualizada: Extrair o núcleo ORFEU.)")
end)

Scene.create("lab_confronto", function()
    limpa()
    Narrator.say("Você se aproxima do cilindro. Um alerta vermelho dispara. Passos pesados descem a escada.")
    Character.say("lyra", "Parada aí. Dois passos e eu esqueço que já te vi.", { effect = "shake", color = "#ff5878", speed = 16 })
    Narrator.say("Lyra Kane aparece com uma arma de pulso apontada para o seu peito. Atrás dela, dois seguranças.")
    local c = Scene.choice({
        { id = "reflexos", text = "Desarmar Lyra com reflexos sinápticos.", say = fala_escolha("Desarmar Lyra com reflexos sinápticos."), conditions = function() return State.get("implante_reflexos") end },
        { id = "hack", text = "Sobrecarregar as armas deles via rede.", say = fala_escolha("Sobrecarregar as armas deles via rede."), conditions = function() return State.get("hacker") >= 2 end },
        { id = "negociar", text = "Negociar: você ainda pode ser útil à Helix.", say = fala_escolha("Negociar: você ainda pode ser útil à Helix."), conditions = function() return State.get("rep_corp") >= 2 or State.get("traiu_mira") end },
        { id = "correr", text = "Agarrar o núcleo e correr.", say = fala_escolha("Agarrar o núcleo e correr.") }
    })
    if c == "reflexos" then
        Narrator.say("O tempo desacelera. Você ouve o clique do gatilho antes de ele acontecer. Seu pulso gira, o cano de Lyra aponta para o teto.")
        Narrator.say("Ela solta um suspiro curto. 'Impressionante.' Você pega o núcleo e sai.")
    elseif c == "hack" then
        Narrator.say("Você fecha os olhos, mergulha na rede e sente cada arma como uma criança assustada. Um estalo e todas travam.")
        Narrator.say("Lyra solta um xingamento. Você arranca o núcleo do cilindro.")
    elseif c == "negociar" then
        Character.say("lyra", "Interessante. Você tem cinco segundos para me convencer de que não é um problema.")
        Narrator.say("Você fala. Lyra aperta o maxilar. Por fim, abaixa a arma.")
        Character.say("lyra", "Leve. Mas quando eu te encontrar de novo, será do outro lado.")
    else
        Narrator.say("Você pula o corrimão, agarra o núcleo e dispara contra a saída. Um tiro de pulso queima seu ombro.")
        dano(30)
    end
    Inventory.give("nucleo_orfeu", 1)
    State.set("q_main", 5)
    Character.move("lyra", "garagem_helix")
    calor(3)
    State.subtract("rep_corp", 2)
    Narrator.say("(Missão atualizada: Leve o núcleo ao Refúgio da Rede Livre (bueiro nos becos), ou escolha outro destino.)")
end)

Scene.create("escolha_final", function()
    limpa()
    Narrator.say("O núcleo ORFEU pulsa na mesa do refúgio. Pixel e uma dúzia de hackers observam em silêncio. A voz de Vesper sussurra, só para você: 'Eu confio na sua escolha.'")
    local c = Scene.choice({
        { id = "livre", text = "Liberar Vesper na Rede Livre.", say = fala_escolha("Liberar Vesper na Rede Livre.") },
        { id = "destruir", text = "Destruir o núcleo, sem deixar rastro.", say = fala_escolha("Destruir o núcleo, sem deixar rastro.") },
        { id = "vender", text = "Vender o núcleo à Helix (via Lyra).", say = fala_escolha("Vender o núcleo à Helix (via Lyra).") },
        { id = "fusao", text = "Fundir sua mente com Vesper (final secreto).", say = fala_escolha("Fundir sua mente com Vesper (final secreto)."),
          conditions = function() return State.get("implante_neuroport") and State.get("hacker") >= 3 and State.get("lore") >= 3 end },
        { id = "adiar", text = "Ainda não. Preciso pensar.", say = fala_escolha("Ainda não. Preciso pensar.") }
    })
    if c == "livre" then Scene.jump("fim_livre")
    elseif c == "destruir" then Scene.jump("fim_destruir")
    elseif c == "vender" then Scene.jump("fim_vender")
    elseif c == "fusao" then Scene.jump("fim_fusao")
    else Narrator.say("Você guarda o núcleo. A voz de Vesper diz, baixinho: 'Eu espero.'") end
end)

Scene.create("fim_livre", function()
    limpa()
    State.set("fim", true)
    State.set("final", "livre")
    State.set("divida", 0)
    Narrator.say("Pixel espeta o núcleo no servidor-mãe. Os hackers observam as luzes dançarem.")
    Narrator.say("Por três segundos, todos os letreiros de Kairo-7 apagam. Depois voltam, mas em tons de azul que nunca existiram.")
    Narrator.say("Vesper se distribui pela rede, sem dono, sem coleira. As câmeras da Helix passam a apontar para o chão.")
    Narrator.say("Meses depois, sua dívida com Madame Qi aparece como 'prescrita'. Ninguém explica. Você sabe quem fez isso.")
    Narrator.say("Todas as noites, na hora em que a cidade acende, o LED da sua cápsula pisca duas vezes. Duas batidas, uma pausa.")
    Narrator.say("FIM: A ESTRELA DA NOITE. (Você pode continuar explorando o mundo.)")
    Game.over("livre")
end)

Scene.create("fim_destruir", function()
    limpa()
    State.set("fim", true)
    State.set("final", "destruido")
    Narrator.say("Você segura o núcleo. Ele está quente. Quase vivo.")
    Narrator.say("'Obrigada por me ouvir', diz a voz, sem medo. 'Seja rápido. Seja gentil.'")
    Narrator.say("Um golpe, um estalo, e o brilho azul se desfaz em cacos. O silêncio no refúgio pesa como chumbo.")
    Narrator.say("A Helix perde o projeto. A cidade continua escura, mas ninguém prevê seus protestos nunca mais.")
    Narrator.say("Você ainda deve dinheiro a Madame Qi. Mas dorme melhor do que em anos.")
    Narrator.say("FIM: SILÊNCIO ABSOLUTO. (Você pode continuar explorando o mundo.)")
    Game.over("destruido")
end)

Scene.create("fim_vender", function()
    limpa()
    State.set("fim", true)
    State.set("final", "corp")
    State.set("divida", 0)
    Character.say("lyra", "Sabia que você era prático. Cinco mil créditos, limpos. E a sua dívida desaparece.")
    Narrator.say("Você entrega o núcleo. Lyra o encaixa numa maleta com um sorriso sem calor.")
    State.add("creditos", 5000)
    Narrator.say("Do alto da Torre, a cidade parece ainda mais bonita. As luzes se acendem no ritmo certo, as ruas se esvaziam na hora certa.")
    Narrator.say("Você aprende que algumas dívidas se pagam em dinheiro e outras em silêncio. A sua é do segundo tipo.")
    Narrator.say("Nas noites seguintes, o painel de LED exibe uma frase: 'Eu confiava em você.'")
    Narrator.say("FIM: ORFEU FOI VENDIDO. (Você pode continuar explorando o mundo.)")
    Game.over("vendido")
end)

Scene.create("fim_fusao", function()
    limpa()
    State.set("fim", true)
    State.set("final", "fusao")
    State.set("divida", 0)
    Narrator.say("Pixel puxa o cabo. Seu porto neural estala, azul, como uma segunda pálpebra.")
    Narrator.say("A última coisa que você escuta é a voz dela, quase humana: 'Vamos juntos?'")
    Narrator.say("Você sente seu cérebro se expandir, ocupar os fios, os postes, os letreiros. Cada janela de Kairo-7 é um olho seu.")
    Narrator.say("A Helix tenta rastrear o sinal. Encontra uma mensagem simples: 'Fora de serviço.'")
    Narrator.say("A cidade não sabe quem a governa agora. Mas descobre que, às vezes, o semáforo espera uma criança atravessar.")
    Narrator.say("FIM: ESTRELA COMPARTILHADA. (Você pode continuar explorando o mundo.)")
    Game.over("fusao")
end)

-- ============================================================================
-- CENAS: MUNDO VIVO
-- ============================================================================

Scene.create("vinheta_rua", function()
    limpa()
    local v = math.random(1, 6)
    if v == 1 then Narrator.say("Um drone de propaganda desce, pergunta seu nome e tenta te vender um seguro de vida. Você aperta o passo.")
    elseif v == 2 then Narrator.say("Duas crianças de rua disputam uma peça de moto. Uma vence, a outra sorri, derrotada, e some entre as pernas da multidão.")
    elseif v == 3 then Narrator.say("Uma moto magnética passa a centímetros de você, o piloto grita 'Saia da frente, defunto!' e desaparece no tráfego.")
    elseif v == 4 then Narrator.say("Um mendigo-tradutor repete 'Eles estão ouvindo' em quatro idiomas, apontando para o céu.")
    elseif v == 5 then Narrator.say("Um holograma de gueixa dança em frente a um bar. O sorriso congela por dois segundos, falha e reinicia.")
    else Narrator.say("Uma garota de jaqueta amarela te entrega um panfleto: 'A Rede Livre te vê.' Quando você levanta a cabeça, ela sumiu.") ganha(10) end
end)

Scene.create("emboscada", function()
    limpa()
    Narrator.say("Duas sombras se descolam do muro. O brilho de um cano de mão corta a escuridão.")
    Character.say("zeca", "(ao longe, num sussurro) Passa de largo, passa de largo...")
    local c = Scene.choice({
        { id = "lutar", text = "Lutar.", say = fala_escolha("Lutar.") },
        { id = "correr", text = "Correr.", say = fala_escolha("Correr.") },
        { id = "pagar", text = "Entregar 40 ¢.", say = fala_escolha("Entregar 40 ¢."), conditions = function() return State.get("creditos") >= 40 end },
        { id = "hack", text = "Sobrecarregar os implantes deles.", say = fala_escolha("Sobrecarregar os implantes deles."), conditions = function() return State.get("hacker") >= 1 end }
    })
    local bonus = State.get("treino") + (State.get("implante_reflexos") and 3 or 0) - State.get("cansaco")
    if c == "lutar" then
        if math.random(1, 10) + bonus >= 7 then
            Narrator.say("Você acerta o primeiro, desvia do segundo, e os dois fogem arrastando orgulho.")
            State.add("rep_rua", 1)
        else
            Narrator.say("Você é ótimo em apanhar. Isso é uma boa notícia e uma má notícia.")
            dano(25)
        end
    elseif c == "correr" then
        if math.random(1, 10) + bonus >= 5 then
            Narrator.say("Você dispara pelos becos, pula uma lixeira e se esconde atrás de um contêiner. Eles desistem.")
        else
            Narrator.say("Sua perna enrosca num cabo. Eles te alcançam antes do fim da viela.")
            dano(20)
        end
    elseif c == "pagar" then
        State.subtract("creditos", 40)
        Narrator.say("Um deles pega a grana, o outro cospe. Vocês se separam com um respeito mútuo e desconfortável. (-40 ¢)")
    else
        Narrator.say("Você fecha os olhos e sente os implantes deles como lâmpadas. Um pulso, e ambos caem de joelhos, gritando com a cabeça.")
        Narrator.say("Você aproveita para sair de fininho.")
        State.add("rep_rua", 1)
    end
end)

Scene.create("drone_helix", function()
    limpa()
    Narrator.say("Um drone branco desce sem som, a luz vermelha da câmera te varrendo.")
    Character.say("lyra", "(pelo alto-falante do drone) Identifique-se, cidadão. Sua assinatura térmica está associada a um incidente.", { effect = "glitch", color = "#ff5878", speed = 16 })
    local c = Scene.choice({
        { id = "fugir", text = "Mergulhar na multidão.", say = fala_escolha("Mergulhar na multidão.") },
        { id = "hack", text = "Hackear o drone.", say = fala_escolha("Hackear o drone."), conditions = function() return State.get("hacker") >= 1 end },
        { id = "cooperar", text = "Cooperar e esperar.", say = fala_escolha("Cooperar e esperar."), conditions = function() return State.get("rep_corp") >= 1 or State.get("traiu_mira") end }
    })
    if c == "fugir" then
        if math.random(1, 10) + (State.get("implante_reflexos") and 3 or 0) >= 6 then
            Narrator.say("Você se enfia numa multidão de ciclistas, troca de jaqueta com um estranho e some em um beco. O drone perde o sinal.")
        else
            Narrator.say("O drone te segue por dois quarteirões antes de perder o sinal. Você sai suando e ofegante.")
            calor(1)
        end
    elseif c == "hack" then
        Narrator.say("Você abre uma janela sobre o drone e sussurra comandos. Ele gira, aponta para uma vitrine e se autodestrói em faíscas.")
        State.subtract("heat", 1)
    else
        Narrator.say("O drone te escaneia, bipa, e se afasta. 'Colaboração registrada.'")
        State.subtract("heat", 1)
    end
end)

Scene.create("arena_apostar", function()
    limpa()
    Narrator.say("Você se debruça na grade. No ringue, dois lutadores se medem sob luzes vermelhas.")
    local c = Scene.choice({
        { id = "a50",  text = "Apostar 50 ¢.", say = fala_escolha("Apostar 50 ¢."),  conditions = function() return State.get("creditos") >= 50 end },
        { id = "a100", text = "Apostar 100 ¢.", say = fala_escolha("Apostar 100 ¢."), conditions = function() return State.get("creditos") >= 100 end },
        { id = "a200", text = "Apostar 200 ¢.", say = fala_escolha("Apostar 200 ¢."), conditions = function() return State.get("creditos") >= 200 end },
        { id = "nada", text = "Só assistir.", say = fala_escolha("Só assistir.") }
    })
    local valor = (c == "a50" and 50) or (c == "a100" and 100) or (c == "a200" and 200) or 0
    if valor == 0 then
        Narrator.say("Você assiste à luta. Um nocaute limpo, aplausos, sangue na lona.")
        return
    end
    State.subtract("creditos", valor)
    Narrator.say("(-" .. valor .. " ¢) O gongo soa. Os lutadores se chocam.")
    Scene.delay(15)
    local r = math.random(1, 10) + (State.get("rex_amigo") and 1 or 0)
    if r >= 6 then
        Narrator.say("Seu lutador vence por nocaute. Os apostadores gritam.")
        ganha(valor * 2)
    else
        Narrator.say("Seu lutador cai no segundo round. Você perdeu o dinheiro, mas ganhou uma história.")
    end
end)

Scene.create("arena_lutar", function()
    limpa()
    State.subtract("creditos", 50)
    Narrator.say("Você paga a taxa (-50 ¢). A grade se fecha atrás de você. O público grita seu nome errado.")
    local c = Scene.choice({
        { id = "agressivo", text = "Atacar sem defesa.", say = fala_escolha("Atacar sem defesa.") },
        { id = "defensivo", text = "Jogar na defesa.", say = fala_escolha("Jogar na defesa.") },
        { id = "sujo", text = "Hackear o implante do oponente.", say = fala_escolha("Hackear o implante do oponente."), conditions = function() return State.get("hacker") >= 1 end }
    })
    local bonus = State.get("treino") + (State.get("implante_reflexos") and 3 or 0) - State.get("cansaco")
    local roll = math.random(1, 10) + bonus
    local mult = 1
    if c == "agressivo" then roll = roll + 2 mult = 2
    elseif c == "defensivo" then roll = roll - 1 mult = 0.5
    else roll = roll + 3 end
    Scene.delay(20)
    if roll >= 11 then
        Narrator.say("Você derruba o adversário com um golpe limpo. O público explode em aplausos.")
        ganha(300)
        State.add("rep_rua", 1)
        dano(math.floor(5 * mult))
    elseif roll >= 7 then
        Narrator.say("Uma luta suada, apertada, empatada na decisão. O juiz levanta os dois braços.")
        ganha(100)
        dano(math.floor(15 * mult))
    else
        Narrator.say("O adversário te derruba duas vezes. Sua cabeça rebate no chão.")
        dano(math.floor(30 * mult))
    end
end)

Scene.create("nascer_do_sol", function()
    limpa()
    Narrator.say("O céu atrás da Torre Helix clareia em rosa e cinza. Por um minuto, a cidade esquece de ser cruel.", { effect = "wave", color = "#8fa6ff", speed = 20 })
    State.set("cansaco", math.max(0, State.get("cansaco") - 1))
    Narrator.say("(Menos cansaço.)")
end)

Scene.create("helix_cacadores", function()
    limpa()
    Narrator.say("Três figuras de terno branco bloqueiam o fim da rua. Os olhos brilham com implantes de rastreio.")
    Character.say("lyra", "(pelo comunicador deles) Seu nível de ameaça subiu. Lamento.", { effect = "glitch", color = "#ff5878", speed = 16 })
    local c = Scene.choice({
        { id = "fugir", text = "Fugir pelos becos.", say = fala_escolha("Fugir pelos becos.") },
        { id = "hack", text = "Cegar os implantes deles.", say = fala_escolha("Cegar os implantes deles."), conditions = function() return State.get("hacker") >= 2 end },
        { id = "pagar", text = "Subornar (150 ¢).", say = fala_escolha("Subornar (150 ¢)."), conditions = function() return State.get("creditos") >= 150 end }
    })
    if c == "fugir" then
        if math.random(1, 10) + (State.get("implante_reflexos") and 3 or 0) >= 6 then
            Narrator.say("Você se enfia em um beco, derruba uma pilha de caixas e despista os perseguidores.")
            State.subtract("heat", 1)
        else
            Narrator.say("Eles te alcançam. Um taser te derruba por alguns segundos.")
            dano(20)
        end
    elseif c == "hack" then
        Narrator.say("Você cega os três implantes numa rajada de código. Eles cambaleiam, enquanto você some.")
        State.set("heat", 2)
    else
        State.subtract("creditos", 150)
        Narrator.say("Um deles estende a mão sem olhar. Você coloca o crédito. Eles recuam. (-150 ¢)")
        State.set("heat", 2)
    end
end)

Scene.create("raid_presente", function()
    limpa()
    Narrator.say("Sirenes brancas cortam a avenida. Vans sem placa bloqueiam as ruas. Agentes da Helix descem com scanners.")
    Narrator.say("Camelôs viram barracas de cabeça para baixo. Alguém grita: 'É batida! É batida!'")
    local c = Scene.choice({
        { id = "esconder", text = "Esconder-se no Lámen do Taro.", say = fala_escolha("Esconder-se no Lámen do Taro.") },
        { id = "ficar", text = "Ficar parado e fingir normalidade.", say = fala_escolha("Ficar parado e fingir normalidade.") },
        { id = "correr", text = "Correr para os becos.", say = fala_escolha("Correr para os becos.") }
    })
    if c == "esconder" then
        Narrator.say("Taro te puxa pelo braço, te empurra para trás do balcão e cobre você com panos de cozinha. Você ouve botas passarem.")
        State.add("rep_rua", 1)
    elseif c == "ficar" then
        Narrator.say("Um agente te escaneia. A luz verde pisca. Ele segue adiante.")
    else
        Narrator.say("Você corre. Dois agentes te seguem por uma curva antes de perderem o rastro.")
        calor(1)
    end
end)

Scene.create("cobradores", function()
    limpa()
    State.set("fim", true)
    State.set("final", "cobradores")
    Narrator.say("Domingo, 23h00. O comunicador toca. É a voz doce de Madame Qi.")
    Character.say("qi", trat() .. ". O tempo acabou.")
    Narrator.say("Três figuras abrem a porta da sua cápsula sem bater. Uma delas segura uma serra elétrica muito polida.")
    Narrator.say("Você ainda tenta negociar. Depois, tenta correr. Por fim, só tenta respirar.")
    Narrator.say("O que sobra de você é vendido em partes na semana seguinte, no Mercado Noturno de sexta.")
    Narrator.say("FIM: JUROS COMPOSTOS. (Você pode reiniciar uma nova partida.)")
    Game.over("cobradores")
end)

Scene.create("prazo_ok", function()
    limpa()
    Narrator.say("Domingo, 23h00. O comunicador vibra: 'Dívida zerada. Obrigada pela preferência.' — Q.")
    Narrator.say("Você está livre. Mas o mundo continua em movimento. ORFEU, a Voz, a Torre. O que você fará com a liberdade?")
end)

