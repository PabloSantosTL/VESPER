          conditions = function(ctx) return State.get("creditos") >= 30 end,
          scene = "boato" }
    }
})

Room.create("nexus", {
    title = "NetHaven (ciber-café)",
    description = "Fileiras de terminais velhos com adesivos de gato e caveira. Ventoinhas ligadas, ar quente, rostos azulados que não olham para ninguém. Placa na entrada: 'Sem comida nas máquinas. Sem desculpas também.'",
    exits = { { id = "rua", to = "cruzamento", label = "Subir para o cruzamento", duration = 2 } },
    actions = {
