          scene = "voz_terminal" }
    }
})

Room.create("av_baixa", {
    title = "Avenida Baixa",
    description = function(ctx)
        local s = "A avenida desce em rampa, com letreiros mais espaçados e manutenção mais atrasada. Postes sem lâmpada, vitrines com grade. À esquerda, o letreiro verde de uma clínica. À direita, um galpão sem janela com a palavra RINHA pintada à mão. No fim da descida o asfalto vira terra e começam as docas."
        if Time.is_night() then s = s .. " Há pessoas sentadas no meio-fio, imóveis, olhando para o mesmo ponto." end
        return s .. clima()
    end,
    exits = {
        { id = "norte", to = "cruzamento", label = "Subir para o cruzamento", duration = 6 },
        { id = "clinica", to = "clinica", label = "Entrar na clínica", duration = 3 },
        { id = "arena", to = "arena", label = "Entrar na Arena Rinha", duration = 4 },
        { id = "beco", to = "becos", label = "Entrar no beco entre os prédios", duration = 4, hidden = true },
        { id = "docas", to = "docas", label = "Descer até as docas", duration = 18 },
        { id = "mercado", to = "mercado_noturno", label = "Ir à praça do Mercado Noturno", duration = 4,
          conditions = function(ctx) return noite_mercado() ~= nil end }
    },
    actions = {
        { id = "observar", label = "Parar e observar a rua (10 min)", duration = 10, scene = "observar_baixa" }
    }
})

Room.create("clinica", {
    title = "Clínica do Doc Sal",
    description = function(ctx)
        local s = "Azulejos manchados, maca de couro rachado, uma prateleira de órgãos em potes de gel. Cheiro forte de antisséptico, café requentado e, por baixo, uma doçura enjoativa que vem de uma porta nos fundos."
        return s
    end,
    exits = {
        { id = "rua", to = "av_baixa", label = "Sair para a avenida", duration = 3 },
        { id = "ala", to = "ala_bruma", label = "Passar pela porta dos fundos", duration = 1, hidden = true }
    },
    actions = {
        falar("sal"),
        falar("rex"),
        { id = "tratamento", label = "Tratamento rápido (40 ¢)", duration = 30,
          conditions = function(ctx) return Character.room("sal") == ctx.room and State.get("saude") < 100 and State.get("creditos") >= 40 end,
          execute = function(ctx)
              limpa()
              State.subtract("creditos", 40)
              curar(60)
              Narrator.say("Sal costura, injeta e resmunga números. Você sente a agulha atravessando a pele em quatro pontos. Sai remendado e sem desconto. (-40 ¢, +60 saúde)")
          end }
    }
})

Room.create("ala_bruma", {
    title = "Ala dos fundos",
    description = "Quatro macas de lona, todas ocupadas. Baldes entre elas, uma torneira pingando num tanque, janelas pintadas de preto por dentro. Os pacientes olham para o teto. Um deles repete uma contagem em voz baixa e volta ao começo toda vez que erra.",
    exits = { { id = "clinica", to = "clinica", label = "Voltar para a clínica", duration = 1 } },
    actions = {
        { id = "ajudar", label = "Ajudar na ala (60 min)", duration = 60, scene = "ala_ajudar" },
        { id = "paciente", label = "Sentar ao lado de um paciente (20 min)", duration = 20, scene = "ala_paciente" }
    }
})

Room.create("arena", {
    title = "Arena Rinha",
    description = function(ctx)
        if arena_ativa() then
            return "Gritaria, suor, luz estroboscópica. Apostadores debruçados na grade, notas nas mãos. No ringue, dois corpos tentam descobrir o que o outro não aguenta. Num painel acima da entrada, os nomes dos lutadores da noite."
        end
        return "Galpão vazio, cheiro de ferro e linimento. O ringue está limpo demais para um lugar onde ninguém é preso. Saco de pancada, banco de supino e um painel apagado com nomes riscados."
    end,
    exits = {
        { id = "rua", to = "av_baixa", label = "Sair para a avenida", duration = 4 },
        { id = "vestiario", to = "vestiario", label = "Passar pela porta do vestiário", duration = 1, hidden = true }
    },
    actions = {
        falar("rex"),
        falar("sal"),
        { id = "quadro", label = "Ler o painel de lutadores (5 min)", duration = 5, scene = "quadro_lutadores" },
        { id = "lutar", label = "Entrar no ringue (taxa 50 ¢)", duration = 40,
          conditions = function(ctx) return arena_ativa() and State.get("saude") > 40 and State.get("creditos") >= 50 end,
          scene = "arena_lutar" },
        { id = "apostar", label = "Apostar numa luta", duration = 20,
          conditions = function(ctx) return arena_ativa() and State.get("creditos") >= 50 end,
          scene = "arena_apostar" }
    }
})

Room.create("vestiario", {
    title = "Vestiário da arena",
    description = "Armários sem porta, banco de madeira lascada, um espelho rachado remendado com fita. Na parede, vinte e três fotos pequenas presas por tachinhas. Em onze delas alguém desenhou um X com caneta vermelha.",
    exits = { { id = "arena", to = "arena", label = "Voltar à arena", duration = 1 } },
    actions = {
        falar("rex"),
        { id = "mural", label = "Olhar as fotos da parede (5 min)", duration = 5, scene = "mural_rex" }
    }
})

Room.create("mercado_noturno", {
    title = "Mercado Noturno",
    description = "Barracas improvisadas sob toldos de plástico, lâmpadas coloridas ligadas em baterias de moto, vendedores gritando em três idiomas. Cheiro de fritura, ozônio e dinheiro suado.",
    exits = { { id = "rua", to = "av_baixa", label = "Voltar à Avenida Baixa", duration = 4 } },
    actions = {
        falar("zeca"),
        { id = "passear", label = "Passear entre as bancas (20 min)", duration = 20, scene = "mercado_passeio" },
        { id = "chip", label = "Comprar o chip de memória da noite (80 ¢)", duration = 10,
          conditions = function(ctx)
              local n = noite_mercado()
              return n ~= nil and not State.get("chip_" .. n) and State.get("creditos") >= 80 and State.get("zeca_conf") >= 1
          end,
          execute = function(ctx)
              limpa()
              local n = noite_mercado()
              if not n then Narrator.say("A banca já sumiu.") return end
              State.set("chip_" .. n, true)
              State.subtract("creditos", 80)
              Inventory.give(CHIP[n], 1)
              Narrator.say("Uma mão sem rosto troca o chip por 80 ¢. 'Não use em público', diz a voz. (Use pelo inventário.)")
          end }
    }
})

Room.create("becos", {
    title = "Becos do Distrito 9",
    description = function(ctx)
        local s = "Vielas entre prédios que quase se tocam. Poças refletindo letreiros distantes, ratos mecânicos roendo fios, pichações de um olho riscado. Cheiro de lixo e de algo doce."
        if State.get("heat") >= 4 then s = s .. " Há pegadas novas de bota pesada na lama." end
        return s .. clima()
    end,
    exits = {
        { id = "rua", to = "av_baixa", label = "Voltar à Avenida Baixa", duration = 4 },
        { id = "docas", to = "docas", label = "Seguir o beco até as docas", duration = 10 },
        { id = "cozinha", to = "cozinha_taro", label = "Entrar pela porta dos fundos do lámen", duration = 2, hidden = true },
        { id = "bueiro", to = "refugio", label = "Descer pelo bueiro marcado", duration = 8, hidden = true }
    },
    actions = {
        falar("zeca"),
        falar("mira"),
        { id = "brumados", label = "Falar com as pessoas sentadas no chão (10 min)", duration = 10, scene = "bruma_beco" },
        { id = "gato", label = "Seguir o brilho azul (30 min)", duration = 30,
          conditions = function(ctx) return State.get("q_gato") == 1 and State.get("pista_gato") >= 1 end,
          scene = "gato_busca" },
        { id = "lixo", label = "Revistar lixeiras (20 min)", duration = 20,
          execute = function(ctx)
              limpa()
              local r = math.random(1, 10)
              if r >= 9 then Narrator.say("Entre cascas e fios, uma carteira vazia com um chip de crédito colado na costura.") ganha(20)
              elseif r <= 2 then Narrator.say("Uma agulha usada fura sua luva.") State.subtract("saude", 3) Narrator.say("(-3 de saúde)")
              elseif r == 3 then Narrator.say("Embaixo de uma caixa, uma ampola azul-acinzentada, vazia. Alguém a limpou com a língua antes de largar.") State.add("lore_bruma", 1)
              else Narrator.say("Só lixo. E o cheiro de lixo.") end
          end }
    }
})

Room.create("docas", {
    title = "Docas abandonadas",
    description = function(ctx)
        local s = "Guindastes enferrujados, contêineres empilhados em torres tortas, o rio escuro sem reflexo. Um barco inteiro afundado no cais, só a antena de fora."
        if Time.is_night() then s = s .. " À noite só se ouvem correntes batendo em ferro e passos que podem ser seus." end
        return s .. clima()
    end,
    exits = {
        { id = "rua", to = "av_baixa", label = "Subir até a Avenida Baixa", duration = 18 },
        { id = "becos", to = "becos", label = "Voltar pelos becos", duration = 10 },
        { id = "conteineres", to = "conteineres_sul", label = "Ir aos contêineres do lado sul", duration = 5, hidden = true },
        { id = "armazem", to = "armazem_qi", label = "Entrar no armazém de Madame Qi", duration = 2, hidden = true }
    },
    actions = {
        falar("qi", 8),
        { id = "olhar", label = "Olhar o rio (10 min)", duration = 10, scene = "olhar_rio" },
        { id = "trabalho", label = "Fazer um trabalho sujo para Madame Qi (90 min)", duration = 90,
          conditions = function(ctx)
              return Character.room("qi") == ctx.room and State.get("divida") > 0 and State.get("qi_dia") ~= Time.day() and State.get("saude") > 30
          end,
          scene = "trabalho_qi" }
    }
})

Room.create("armazem_qi", {
    title = "Armazém de Madame Qi",
    description = "Armazém de pé direito alto. No centro, uma mesa redonda com bule de ferro, três xícaras, balança de precisão e um livro-caixa encadernado em couro. Duas cadeiras para quem deve, uma para quem cobra. Dois homens de casaco comprido esperam perto da porta e não olham para nada.",
    exits = { { id = "docas", to = "docas", label = "Sair para as docas", duration = 2 } },
    actions = {
        falar("qi", 8),
        { id = "livro", label = "Olhar o livro-caixa", duration = 5, scene = "livro_qi" },
        { id = "trabalho", label = "Fazer um trabalho sujo para Madame Qi (90 min)", duration = 90,
          conditions = function(ctx)
              return Character.room("qi") == ctx.room and State.get("divida") > 0 and State.get("qi_dia") ~= Time.day() and State.get("saude") > 30
          end,
          scene = "trabalho_qi" }
    }
})

Room.create("conteineres_sul", {
    title = "Contêineres do lado sul",
    description = "Corredor de contêineres empilhados, tinta descascando, números de série raspados. O chão tem poças de óleo e marcas de empilhadeira. Um dos contêineres está com a porta entreaberta há dias.",
    exits = { { id = "docas", to = "docas", label = "Voltar às docas", duration = 5 } },
    actions = {
        { id = "procurar", label = "Procurar o mensageiro morto (45 min)", duration = 45,
          conditions = function(ctx) return State.get("q_main") == 1 end,
          scene = "docas_busca" }
    }
})

-- ---------- Torre Helix ----------

Room.create("fachadas", {
    title = "Rua das Fachadas Brancas",
    description = function(ctx)
        local s = "Prédios corporativos com vitrines vazias, calçada lavada por drones, câmera a cada seis metros. O Distrito 9 fica para trás. À frente, a Torre Helix inteira, sem sobrar espaço para o céu."
        if State.get("blackout") then s = s .. " Com a energia cortada, as câmeras estão com o led apagado e os drones parados no chão." end
        return s
    end,
    exits = {
        { id = "cruzamento", to = "cruzamento", label = "Voltar ao cruzamento", duration = 12 },
        { id = "torre", to = "torre_helix", label = "Entrar no saguão da Torre", duration = 3 }
    },
    actions = {
        { id = "observar", label = "Observar a Torre do outro lado da rua (15 min)", duration = 15, scene = "observar_torre" }
    }
})

Room.create("torre_helix", {
    title = "Saguão da Torre Helix",
    description = function(ctx)
        local s = "Mármore preto, lustres de luz fria, um logotipo de dois metros girando no ar. Seguranças de terno branco fingem não te ver, e te veem."
        if State.get("blackout") then s = s .. " As luzes estão em modo de emergência: vermelhas, tremulantes." end
        return s
    end,
    exits = {
        { id = "rua", to = "fachadas", label = "Sair da Torre", duration = 3 },
        { id = "elevador_lab", to = "laboratorio", label = "Entrar no elevador do laboratório", duration = 6, hidden = true }
    },
    actions = {
        falar("lyra", 8),
        { id = "cracha", label = "Mostrar o crachá falso ao segurança", duration = 10,
          conditions = function(ctx) return State.get("q_main") >= 3 and Inventory.has("cracha_falso") and not State.get("lab_aberto") end,
          scene = "lobby_cracha" },
        { id = "servico", label = "Entrar pela porta de serviço", duration = 15,
          conditions = function(ctx) return State.get("q_main") >= 3 and State.get("blackout") and not State.get("lab_aberto") end,
          scene = "lobby_servico" },
        { id = "emp", label = "Detonar a granada de pulso EMP", duration = 5,
          conditions = function(ctx) return State.get("q_main") >= 3 and Inventory.has("pulso_emp") and not State.get("lab_aberto") end,
          scene = "lobby_emp" },
        { id = "painel", label = "Invadir o painel de acesso", duration = 30,
          conditions = function(ctx) return State.get("q_main") >= 3 and State.get("hacker") >= 2 and not State.get("lab_aberto") end,
          scene = "lobby_hack" },
        { id = "voz_porta", label = "Pedir ajuda à Voz pelo comunicador", duration = 10,
          conditions = function(ctx) return State.get("q_main") >= 3 and State.get("vozes") >= 3 and not State.get("lab_aberto") end,
          scene = "lobby_voz" }
    }
})

Room.create("laboratorio", {
    title = "Laboratório Subnível 9 (ORFEU)",
    description = "Vidro, fibra óptica e um zumbido grave que faz os dentes vibrarem. No centro, um pilar de luz azul abriga um núcleo flutuando em fluido. Ao redor, estações de trabalho com cadeiras viradas, canecas ainda com café, uma jaqueta pendurada num encosto.",
    exits = {
        { id = "elevador", to = "torre_helix", label = "Voltar ao elevador", duration = 6,
