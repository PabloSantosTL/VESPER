-- ============================================================================
--  NEON VESPER 2.0  —  uma história para a engine Vesper
--  Kairo-7, Distrito 9. Você tem uma semana para pagar uma dívida impagável.
--
--  Começa segunda-feira, 23h10. Prazo da dívida: domingo (dia 7), 23h00.
--
--  O QUE MUDOU NESTA VERSÃO
--   * Tela de criação, HUD, pontos de salvamento, finais e console limpo
--   * Mapa em camadas: o prédio, a avenida, o cruzamento, a avenida baixa,
--     os becos, as docas e a Torre. Salas escondidas se abrem por conversa,
--     rumor ou curiosidade.
--   * Cada personagem tem cena de apresentação, rotina visível e vários
--     assuntos de conversa. Quase nenhuma dica é dada de graça: o que existe
--     vem em rumores, jornais, conversas ouvidas e anotações de terceiros.
--   * A semana é pesada: a Bruma (droga de rua) e o apagão do dia 4 correm
--     por baixo de tudo.
-- ============================================================================

Project.create({
    id = "neon_vesper",
    title = "NEON VESPER",
    version = "2.0.0",
    author = "Vesper",
    description = "Uma semana em Kairo-7."
})

Variables.define({
    nome = "",
    creditos = 350, divida = 3000, saude = 100, cansaco = 0, heat = 0,
    rep_rua = 0, rep_corp = 0, hacker = 0, treino = 0,
    q_main = 0, q_gato = 0, q_taro = 0, pista_gato = 0,
    entregas = 0, entregou_sal = false, entregou_pixel = false, entregou_rex = false,
    lore = 0, lore_bruma = 0, vozes = 0, pista_apagao = false, chuva = false, blackout = false,
    implante_reflexos = false, implante_neuroport = false, lab_aberto = false,
    chip_wednesday = false, chip_friday = false, chip_saturday = false,
    traiu_mira = false, fim = false, final = "", rex_amigo = false,
    taro_amigo = false, mira_conhece = false, ajudou_dia = 0, qi_dia = 0,
    ishi_conf = 0, taro_conf = 0, sal_conf = 0, pixel_conf = 0, mira_conf = 0,
    qi_conf = 0, rex_conf = 0, lyra_conf = 0, zeca_conf = 0,
    met_ishi = false, met_taro = false, met_sal = false, met_pixel = false,
    met_mira = false, met_qi = false, met_rex = false, met_lyra = false, met_zeca = false,
    lyra_caca = false, escapou = false, oferta_lyra = false,
    horta_dia = 0, radio_dia = 0,
    apresentou_ishi = false, apresentou_taro = false, apresentou_sal = false,
    apresentou_pixel = false, apresentou_mira = false, apresentou_qi = false,
    apresentou_rex = false, apresentou_lyra = false, apresentou_zeca = false,
    ouviu_rui = false, rumor_zeca = false, rumor_zeca_camelo = false,
    rumor_zeca_mira = false, conhece_juca = false
})

-- ============================================================================
-- CRIAÇÃO DE PERSONAGEM
-- ============================================================================

Creation.define({
    title = "Quem deve três mil?",
    description = "Kairo-7 não pergunta quem você foi. Madame Qi pergunta quanto você deve. Antes da primeira mensagem chegar, decida quem atende o comunicador.",
    button = "Entrar em Kairo-7",
    fields = {
        { id = "nome", type = "text", label = "Nome", placeholder = "Como te chamam no Bloco 14?", max = 16, variable = "nome" },
        { id = "genero", type = "choice", label = "Como as pessoas falam de você", options = {
            { id = "f", text = "Ela" },
            { id = "m", text = "Ele" },
            { id = "n", text = "Prefiro não dizer" }
        } },
        { id = "origem", type = "choice", label = "O que você fazia antes", options = {
            { id = "entregador", text = "Entregador de moto", description = "Conhece as ruas e quem trabalha nelas. +1 reputação de rua.", add = { rep_rua = 1 } },
            { id = "helix", text = "Estagiário da Helix", description = "Já usou crachá da Torre. Sabe como eles falam. +1 reputação corporativa.", add = { rep_corp = 1 } },
            { id = "sucata", text = "Técnico de sucata", description = "Passou anos com a mão dentro de máquinas alheias. Hacking nível 1.", add = { hacker = 1 } },
            { id = "ringue", text = "Lutador de porão", description = "Já apanhou por dinheiro. Treino nível 1.", add = { treino = 1 } }
        } },
        { id = "motivo", type = "choice", label = "De onde vem a dívida", options = {
            { id = "mae", text = "Tratamento da sua mãe", description = "Ela morreu mesmo assim. A conta não." },
            { id = "aposta", text = "Aposta que deu errado", description = "Você tinha certeza. Esse foi o erro." },
            { id = "implante", text = "Implante pirata", description = "Funcionou por duas semanas." },
            { id = "irmao", text = "Dívida herdada do seu irmão", description = "Ele sumiu. O contrato ficou." }
        } },
        { id = "tracos", type = "multi", label = "Traços", hint = "Escolha até dois.", max = 2, required = false, options = {
            { id = "cara_de_pau", text = "Cara de pau", description = "Mente olhando nos olhos. Abre opções de blefe." },
            { id = "maos_rapidas", text = "Mãos rápidas", description = "Mais chance em fugas, lutas e trabalhos." },
            { id = "pavio_curto", text = "Pavio curto", description = "Abre opções de partir pra cima. Nem sempre é boa ideia." },
            { id = "curioso", text = "Curioso", description = "Repara em detalhes que os outros deixam passar." }
        } }
    }
})

-- ============================================================================
-- HUD
-- ============================================================================

HUD.define({
    { var = "saude", label = "Saúde", style = "bar", max = 100, color = "#ff3b4e", warn = 0.3 },
    { var = "creditos", label = "Créditos", style = "number", suffix = " ¢" },
    { var = "divida", label = "Dívida com Qi", style = "number", suffix = " ¢", color = "#ffb020" },
    { var = "cansaco", label = "Cansaço", style = "pips", max = 5, icon = "▮" },
    { var = "heat", label = "Procurado", style = "pips", max = 6, icon = "◆", color = "#ff3b4e",
      conditions = function() return State.get("heat") > 0 end }
})

World.create("Kairo-7", function()
    World.start("capsula")
    World.clock({ day = 1, weekday = "monday", hour = 23, minute = 10 })
end)

-- ============================================================================
-- FUNÇÕES AUXILIARES
-- ============================================================================

local function limpa() Console.clear() end
local function pausa() Scene.wait() Console.clear() end
local function uma(t) return t[math.random(1, #t)] end
local function nova(k) if State.get("t_" .. k) then return false end State.set("t_" .. k, true) return true end
local function viu(k) return State.get("t_" .. k) == true end
local function conf(id, n) State.add(id .. "_conf", n or 1) end
local function sorteia(chave, n)
    local ult = State.get("ult_" .. chave) or 0
    local i = math.random(1, n)
    if i == ult and n > 1 then i = (i % n) + 1 end
    State.set("ult_" .. chave, i)
    return i
end

local function g(m, f, n)
    local x = Player.get("genero")
    if x == "f" then return f elseif x == "m" then return m end
    return n or m
end
local function trat() return g("querido", "querida", "meu bem") end
local function viz() return g("vizinho", "vizinha", "meu bem") end
local function nome_conhecido(id, alternativa)
    if State.get("apresentou_" .. id) then
        local nome = Player.name()
        if nome and nome ~= "" then return nome end
    end
    return alternativa or "você"
end
local function apresentar(id)
    local flag = "apresentou_" .. id
    if State.get(flag) then
        State.set("met_" .. id, true)
        return
    end
    local nome = Player.name()
    if not nome or nome == "" then nome = "sem nome" end
    Scene.choice({
        { id = "apresentar", text = "Se apresentar: 'Oi, eu sou " .. nome .. ".'",
          say = "Oi, eu sou " .. nome .. ". Prazer." }
    })
    State.set(flag, true)
    State.set("met_" .. id, true)
    local estilos = {
        ishi = { effect = "wave", color = "#9bd8b0", speed = 20 },
        taro = { effect = "wave", color = "#ffbd66", speed = 18 },
        sal = { effect = "pulse", color = "#ffb58a", speed = 18 },
        pixel = { effect = "glitch", color = "#6fe3ff", speed = 16 },
        mira = { effect = "neon", color = "#e8bbff", speed = 18 },
        qi = { effect = "pulse", color = "#ffbd66", speed = 18 },
        rex = { effect = "shake", color = "#ff6b72", speed = 16 },
        lyra = { effect = "neon", color = "#bba8ff", speed = 18 },
        zeca = { effect = "glitch", color = "#a7efbf", speed = 16 }
    }
    Character.say(id, "Prazer, " .. nome .. ". Agora sei como te chamar.", estilos[id])
end
local function tem(tr) return Player.has("tracos", tr) end
local function curioso(t) if tem("curioso") then Narrator.say(t) end end

local function curar(n) State.set("saude", math.min(100, State.get("saude") + n)) end
local function ganha(n) State.add("creditos", n) Narrator.say("(+" .. n .. " ¢)") end
local function gasta(n) State.subtract("creditos", n) Narrator.say("(-" .. n .. " ¢)") end
local function calor(n)
    State.set("heat", math.min(6, State.get("heat") + n))
    Narrator.say("(Procurado +" .. n .. ")")
end
local function esfria(n) State.set("heat", math.max(0, State.get("heat") - (n or 1))) end
local function dano(n)
    State.subtract("saude", n)
    Narrator.say("(-" .. n .. " de saúde)")
    if State.get("saude") <= 0 then Scene.start("apagao_medico") end
end
local function bonus()
    return State.get("treino") + (State.get("implante_reflexos") and 3 or 0)
        + (tem("maos_rapidas") and 1 or 0) - State.get("cansaco")
end
local function aqui(id) return function(ctx) return Character.room(id) == ctx.room end end
local function aqui_e(id, f) return function(ctx) return Character.room(id) == ctx.room and f(ctx) end end
local function ativ(id) return Character.get_state(id, "activity") end
local function noite() local h = Time.hour() return h >= 20 or h < 5 end
local function arena_ativa() local h = Time.hour() return h >= 22 or h < 5 end
local function clima() if State.get("chuva") then return " A chuva ácida deixa uma película verde nas poças." end return "" end
local nomes_personagens = {
    mira = "Mira Voss", taro = "Taro", sal = "Doc Sal", pixel = "Pixel",
    ishi = "Dona Ishi", qi = "Madame Qi", rex = "Rex Quebra-Osso",
    lyra = "Lyra Kane", zeca = "Zeca Fantasma", abel = "Seu Abel",
    neide = "Dona Neide", juca = "Juca", barman = "Bartô", lia = "Lia",
    beto = "Beto", camelo = "Camelô", tv = "Holo-jornal",
    seguranca = "Segurança", agente = "Agente da Helix",
    brumado = "Brumado", vesper = "Vesper"
}
local function nome_de(id) return nomes_personagens[id] or id end

local function falar(id, dur)
    return { id = "falar_" .. id, label = "Falar com " .. nome_de(id), duration = dur or 5,
             conditions = function(ctx)
                 if id == "lyra" and State.get("q_main") >= 5 then return false end
                 local atividade = ativ(id)
                 if type(atividade) == "string" and atividade:find("dormindo", 1, true) then return false end
                 if id == "mira" and atividade == "sumida" then return false end
                 if id == "taro" and ctx.room == "cozinha_taro" and Character.room(id) == "noodle_bar" then return true end
                 return Character.room(id) == ctx.room
             end,
             scene = "talk_" .. id }
end

local function noite_mercado()
    local w, h = Time.weekday(), Time.hour()
    if h >= 21 then
        if w == "wednesday" or w == "friday" or w == "saturday" then return w end
    elseif h < 5 then
        if w == "thursday" then return "wednesday"
        elseif w == "saturday" then return "friday"
        elseif w == "sunday" then return "saturday" end
    end
    return nil
end

local function semana(base, extras)
    local t = {}
    for _, d in ipairs({ "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday" }) do t[d] = base end
    for d, l in pairs(extras or {}) do t[d] = l end
    return t
end

local CHIP = { wednesday = "chip_a", friday = "chip_b", saturday = "chip_c" }

-- Cor do ambiente: só em momentos especiais a história muda a cor da interface.
local function tema_sala()
    local r = World.player_room()
    if r == "laboratorio" then Theme.set({ accent = "#6fe3ff", accent2 = "#8fa6ff", glow = "#6fe3ff", glow2 = "#8fa6ff" })
    elseif State.get("blackout") then Theme.set({ accent = "#ff3b4e", accent2 = "#ff9a3c", glow = "#ff3b4e", glow2 = "#ff9a3c" })
    else Theme.reset() end
end

local function paga(n)
    n = math.min(n, State.get("divida"), State.get("creditos"))
    State.subtract("creditos", n)
    State.subtract("divida", n)
    Narrator.say("Transferido: " .. n .. " ¢. Dívida restante: " .. State.get("divida") .. " ¢.")
end

-- Entrega de tigela: devolve true quando entregou agora.
local function entrega(flag)
    if State.get("q_taro") == 1 and Inventory.has("tigela") and not State.get(flag) then
        Inventory.remove("tigela", 1)
        State.set(flag, true)
        State.add("entregas", 1)
        Narrator.say("Você tira a tampa de alumínio. O vapor sobe quando a tigela chega às mãos de quem espera.")
        if flag == "entregou_sal" then
            if World.player_room() == "arena" then
                Character.say("sal", "Lámen? Bom. Os lutadores esquecem de comer quando começam a sangrar. Vou deixar esfriar um pouco.", { effect = "pulse", color = "#ffb58a", speed = 18 })
                Narrator.say("Sal põe a tigela no banco junto à bolsa médica e volta a conferir os curativos.")
            elseif World.player_room() == "bar_sinapse" then
                Character.say("sal", "Isso chegou na hora certa. Amanhã eu volto para a clínica; hoje só quero terminar a noite sem ouvir um monitor apitar.", { effect = "pulse", color = "#ffb58a", speed = 18 })
                Narrator.say("Sal põe a tigela ao lado do copo, longe da borda do balcão, e volta a olhar para a bebida.")
            else
                Character.say("sal", "Lámen. Você acabou de melhorar o plantão. Obrigado. Deixa aí, eu como quando terminar.", { effect = "pulse", color = "#ffb58a", speed = 18 })
                Narrator.say("Sal deixa a tigela ao lado da bancada e volta ao atendimento.")
            end
        elseif flag == "entregou_pixel" then
            if World.player_room() == "telhado" then
                Character.say("pixel", "Comida de verdade? Você salvou minha noite. Deixa aí, só vou terminar de contar os pulsos da Torre.", { effect = "glitch", color = "#6fe3ff", speed = 16 })
                Narrator.say("Pixel apoia a tigela sobre a caixa d'água, ao lado do comunicador, e só então começa a comer.")
            elseif World.player_room() == "refugio" then
                Character.say("pixel", "Você trouxe comida até aqui? Boa. Os servidores não vão fugir enquanto eu como.", { effect = "glitch", color = "#6fe3ff", speed = 16 })
                Narrator.say("Pixel apoia a tigela ao lado do terminal do refúgio, longe dos cabos expostos.")
            else
                Character.say("pixel", "Você trouxe comida de verdade? Espera. Vou fechar essas janelas antes que alguém roube minha senha.", { effect = "glitch", color = "#6fe3ff", speed = 16 })
                Narrator.say("Pixel apoia a tigela ao lado do teclado, tira uma foto e só então começa a comer.")
            end
        elseif flag == "entregou_rex" then
            Character.say("rex", "Do Taro. Ele ainda lembra que eu existo.", { effect = "shake", color = "#ff6b72", speed = 16 })
            if World.player_room() == "noodle_bar" then
                Narrator.say("Rex puxa a tigela para perto e abre espaço no balcão, sem interromper a refeição.")
            elseif World.player_room() == "clinica" then
                Narrator.say("Rex apoia a tigela no banco ao lado da maca e espera Sal terminar de trocar o curativo.")
            elseif World.player_room() == "vestiario" then
                Narrator.say("Rex deixa a tigela sobre o banco, longe das faixas limpas, e termina de enfaixar as mãos.")
            else
                Narrator.say("Rex segura a tigela com as duas mãos. O primeiro gole interrompe o treino.")
            end
        end
        State.set("entregas", State.get("entregas") + 0)
        Narrator.say("(Entregas: " .. State.get("entregas") .. "/3)")
        if State.get("entregas") >= 3 then
            State.set("q_taro", 2)
            Narrator.say("As três entregas estão feitas. Taro vai querer saber.")
        end
        return true
    end
    return false
end

local function abre_lab(texto)
    Narrator.say(texto)
    State.set("lab_aberto", true)
    Room.reveal("torre_helix", "elevador_lab")
    Game.save("Torre Helix: elevador do laboratório")
end

-- Dá nome a quem fala em cenas de fundo (não aparecem na tela de ambiente).
local function fala(id, t, estilo)
    local estilos = {
        fria = { effect = "neon", color = "#bba8ff", speed = 18 },
        nervosa = { effect = "glitch", color = "#ff7b9c", speed = 16 },
        calma = { effect = "wave", color = "#9bd8b0", speed = 20 }
    }
    Character.say(id, t, estilo and estilos[estilo] or nil)
end

-- O nome do protagonista só é conhecido por quem ouviu sua apresentação.

local function fala_escolha(texto)
    local s = tostring(texto):gsub("%s*%b()", "")
    s = s:gsub("^'(.*)'$", "%1")

    -- Só existe fala quando a escolha representa algo que o protagonista diz.
    local falas = {
        ["Prometer que vai pagar."] = "Eu prometo que vou pagar!",
        ["Perguntar se dá para negociar o prazo."] = "Dá para negociar o prazo?",
        ["Perguntar do gato da Dona Ishi."] = "Você sabe onde está o gato da Dona Ishi?",
        ["Perguntar sobre o Rui da 14-F."] = "Você conhece o Rui da 14-F?",
        ["Perguntar quem é o morador da 14-F."] = "Quem é o morador da 14-F?",
        ["Perguntar como ela cuida do bonsai."] = "Como você cuida desse bonsai?",
        ["Comentar o ruído do elevador."] = "Esse elevador voltou a fazer barulho.",
        ["Perguntar pelo cheiro de chá."] = "Que cheiro é esse? É chá?",
        ["Perguntar que horas ele abre."] = "Que horas você abre?",
        ["Perguntar se ela vem à feira todos os dias."] = "Você vem à feira todos os dias?",
        ["Perguntar se ela cuida da horta sozinha."] = "Você cuida da horta sozinha?",
        ["Perguntar de onde vieram as plantas."] = "De onde vieram essas plantas?",
        ["Perguntar o que ela está ouvindo."] = "O que você está ouvindo?",
        ["Perguntar por que o rádio chia."] = "Esse rádio sempre chia assim?",
        ["Perguntar o que ela observa na feira."] = "O que você está procurando por aqui?",
        ["Perguntar sobre 'o rapaz do cano'."] = "O que você sabe sobre o rapaz do cano?",
        ["Perguntar o que se comenta sobre a Torre."] = "O que andam dizendo sobre a Torre?",
        ["Perguntar ao Bartô o que ele ouve por aqui."] = "O que você tem ouvido por aqui, Bartô?",
        ["Perguntar sobre o cartaz."] = "O que aconteceu com esse cartaz?",
        ["Pedir um lámen."] = "Quero um lámen, por favor.",
        ["Perguntar sobre o garoto de capuz."] = "Você sabe quem é aquele garoto de capuz?",
        ["Comentar o braço quebrado do gato."] = "O que aconteceu com o braço dele?",
        ["Perguntar o preço do atendimento."] = "Quanto custa o atendimento?",
        ["Dizer que volta depois."] = "Vou voltar depois.",
        ["Dizer que também ouve o elevador."] = "Também ouço o elevador.",
        ["Perguntar o que ela está consertando."] = "O que você está consertando?",
        ["Perguntar pelo cheiro de chá."] = "Que cheiro é esse? É chá?",
        ["Perguntar que horas ele abre."] = "Que horas você abre?",
        ["Perguntar onde ele foi visto pela última vez e oferecer ajuda."] = "Onde ele foi visto pela última vez? Posso ajudar a procurar.",
        ["Dizer que está sem tempo."] = "Desculpa, estou sem tempo agora.",
        ["Perguntar por que ela não chamou a manutenção."] = "Por que você não chamou a manutenção?",
        ["Perguntar por que ele serve o garoto de graça."] = "Por que você serve comida de graça para aquele garoto?",
        ["Perguntar pelo gato holográfico no letreiro."] = "O que é aquele gato holográfico no letreiro?",
        ["Perguntar se ele sempre trabalha sozinho."] = "Você sempre trabalha sozinho?",
        ["Perguntar quanto ele paga e por que não manda um drone."] = "Quanto você paga? Por que não manda um drone?",
        ["Aceitar as entregas."] = "Eu levo as tigelas.",
        ["Recusar por enquanto."] = "Agora não, desculpa.",
        ["Perguntar o que Sal acha da cidade."] = "O que você acha desta cidade, Sal?",
        ["Perguntar por que ele está bebendo."] = "Por que você está bebendo, doutor?",
        ["Perguntar sobre trabalhos."] = "Tem algum trabalho disponível?",
        ["Perguntar sobre a rinha."] = "O que você pode me dizer sobre a rinha?",
        ["Perguntar discretamente sobre ORFEU."] = "Você já ouviu falar de ORFEU?",
        ["Oferecer informações sobre Mira (800 ¢)."] = "Tenho informações sobre Mira. Posso vender por 800 créditos.",
        ["Oferecer o núcleo ORFEU (final corporativo)."] = "Quero oferecer o núcleo ORFEU à Helix.",
        ["Negociar: você ainda pode ser útil à Helix."] = "Ainda posso ser útil à Helix. Podemos negociar?",
        ["Perguntar por que ele está trabalhando sozinho."] = "Por que você está trabalhando sozinho?",
        ["Perguntar sobre os casos de Bruma."] = "O que você sabe sobre os casos de Bruma?",
        ["Perguntar o nome dele."] = "Como você se chama?",
        ["Perguntar o que a Bruma faz."] = "O que a Bruma faz com as pessoas?",
        ["Oferecer água e perguntar se precisam de atendimento."] = "Vocês precisam de água ou de atendimento médico?",
        ["Perguntar quem distribui a Bruma."] = "Quem está distribuindo a Bruma?",
        ["Chamar Mochi pelo nome."] = "Mochi!",
        ["Perguntar de onde vieram as sementes."] = "De onde vieram essas sementes?",
        ["Pedir um tomate."] = "Posso pegar um tomate?",
        ["Perguntar quem fez o mural."] = "Quem fez esse mural?",
        ["Perguntar a Rex sobre o nome apagado."] = "Rex, você sabe quem era o nome que apagaram?",
        ["Dizer que o núcleo já foi copiado."] = "O núcleo já foi copiado.",
        ["Agradecer e seguir."] = "Obrigado. Até mais.",
        ["Recusar educadamente."] = "Não, obrigado.",
    }

    if falas[tostring(texto)] then return falas[tostring(texto)] end

    -- Escolhas já escritas como uma fala literal continuam sendo falas.
    if tostring(texto):match("^'.*'$") then return s end
    return nil
end

-- Menu de conversa: topicos = { {id=, txt=, se=function, fn=function}, ... }
local function menu(topicos, sair)
    while true do
        local ops = {}
        for _, t in ipairs(topicos) do ops[#ops + 1] = { id = t.id, text = t.txt, say = fala_escolha(t.txt), conditions = t.se } end
        ops[#ops + 1] = { id = "sair", text = sair or "Encerrar a conversa.", say = "Vou encerrar a conversa." }
        local c = Scene.choice(ops)
        if c == nil or c == "sair" then break end
        for _, t in ipairs(topicos) do if t.id == c then t.fn() end end
    end
end

-- ============================================================================
-- ITENS
-- ============================================================================

Item.define("caderno", { title = "Caderno de anotações", description = "Capa mole, canto queimado. Você anota o que não quer esquecer.",
    use = function(ctx)
        limpa()
        Narrator.say("Você folheia o caderno. Letra sua, pressa sua.")
        Narrator.say("Dívida com Qi: " .. State.get("divida") .. " ¢. Prazo: domingo, 23h00. Hoje é " .. Time.weekday_name() .. ".")
        if State.get("q_main") == 0 and not State.get("met_mira") then Narrator.say("'Bar Sinapse, à noite. Mensagem sem remetente. Assinada M.'") end
        if State.get("q_main") == 1 then Narrator.say("'Mira quer um chip nas Docas. Mensageiro da Helix morto. Lado sul.'") end
        if State.get("q_main") == 2 then Narrator.say("'Chip preto e quente. Precisa de alguém que saiba abrir. Pixel, NetHaven.'") end
        if State.get("q_main") == 3 then Narrator.say("'Tem alguém dentro do chip. A Torre guarda o resto. Cinco jeitos de entrar, nenhum barato.'") end
        if State.get("q_main") == 4 then Narrator.say("'Subnível 9. Pegar o núcleo e sair vivo.'") end
        if State.get("q_main") == 5 then Narrator.say("'O núcleo está comigo. Pensar antes de decidir. Pensar de verdade.'") end
        if State.get("q_gato") == 1 then Narrator.say("'Mochi, gato-drone da Dona Ishi. Orelha esquerda torta. Sumido há dias.'") end
        if State.get("q_taro") == 1 then Narrator.say("'Entregas do Taro: Sal, Pixel, Rex. Ainda faltam " .. (3 - State.get("entregas")) .. ".'") end
        if State.get("lore") > 0 then Narrator.say("'Lena. Hora do Vesper. Lena.' (Você não lembra de ter escrito isso.)") end
    end })

Item.define("chip_cifrado", { title = "Chip cifrado (ORFEU)", description = "Preto, quente, com o logotipo da Helix gravado a laser. Pulsa em intervalos irregulares." })
Item.define("cracha_falso", { title = "Crachá falso da Helix", description = "Impressão perfeita. Só falha se alguém realmente olhar." })
Item.define("pulso_emp", { title = "Granada de pulso EMP", description = "Apaga eletrônicos num raio de dez metros. Inclusive os seus." })
Item.define("bobina_neural", { title = "Bobina neural", description = "Peça rara para o porto neural. Cheira a ozônio." })
Item.define("tigela", { title = "Tigela de lámen do Taro", description = "Tampa de alumínio, vapor escapando. Entrega pendente.", stackable = true })
Item.define("mochi", { title = "Mochi (gato-drone)", description = "Gato cibernético com a orelha esquerda torta. Vibra em baixa frequência quando está tranquilo." })

Item.define("kit_medico", { title = "Kit médico", description = "Seringas, gaze, pó coagulante.", stackable = true,
    use = function(ctx)
        Inventory.remove("kit_medico", 1)
        curar(40)
        Narrator.say("Você abre o pó coagulante com os dentes e fecha o corte com gaze. Dói até o fim. (+40 de saúde)")
    end })

Item.define("cha_ishi", { title = "Chá da Dona Ishi", description = "Um sachê de chá verde de verdade, com data de colheita.",
    use = function(ctx)
        Inventory.remove("cha_ishi", 1)
        curar(15)
        State.set("cansaco", math.max(0, State.get("cansaco") - 2))
        Narrator.say("Você esquenta a água na cápsula e deixa o sachê dois minutos. Tem gosto de folha, e só isso. (+15 saúde, menos cansaço)")
    end })

Item.define("tomate", { title = "Tomate da horta da Ishi", description = "Pequeno, firme, vermelho de verdade. Em Kairo-7 isso é uma pequena fortuna.", stackable = true,
    use = function(ctx)
        Inventory.remove("tomate", 1)
        curar(10)
        Narrator.say("Você morde o tomate em pé. O suco escorre até o pulso. (+10 saúde)")
    end })

Item.define("chip_a", { title = "Chip de memória: Infância", description = "Etiqueta rabiscada: 'D9, 2061'.",
    use = function(ctx)
        limpa()
        Inventory.remove("chip_a", 1)
        State.add("lore", 1)
        Narrator.say("Você encaixa o chip na nuca. Cheiro de sopa de missô. Um apartamento de dois cômodos, chão de linóleo, uma menina de oito anos desmontando um rádio no meio da sala.")
        Narrator.say("Ela se chama Lena. A mãe manda guardar os parafusos numa lata. Lena guarda todos e conta: trinta e um.")
        Narrator.say("'Quando eu crescer eu conserto a cidade inteira', diz Lena, com uma chave de fenda na boca. A mãe ri e pede para ela falar direito.")
        Narrator.say("A memória acaba com a luz da tarde batendo na janela. A menina chama aquele horário de 'hora do Vesper', quando a estrela da noite aparece antes das outras.")
    end })

Item.define("chip_b", { title = "Chip de memória: Projeto", description = "Etiqueta: 'Helix, bloco C, nunca mostrar'.",
    use = function(ctx)
        limpa()
        Inventory.remove("chip_b", 1)
        State.add("lore", 1)
        Narrator.say("Sala branca, mesa de vidro, ar-condicionado alto demais. Lena adulta, olheiras fundas, caneta na mão, folha de contrato de quarenta páginas.")
        Narrator.say("Um executivo de terno claro, de pé atrás dela, diz: 'A última página é só formalidade.' Lena vira as páginas com o polegar, rápido, e assina sem ler a última.")
        Narrator.say("Projeto ORFEU: um sistema preditivo para 'otimizar o comportamento urbano'. Ela acredita que vai evitar mortes em acidentes de trânsito.")
        Narrator.say("Do outro lado da mesa, uma mulher mais jovem, de blazer cinza, olha para a última página e desvia o rosto. A memória embaça nesse ponto. Fica o gosto de metal na boca.")
    end })

Item.define("chip_c", { title = "Chip de memória: Upload", description = "Sem etiqueta. Frio ao toque.",
    use = function(ctx)
        limpa()
        Inventory.remove("chip_c", 1)
        State.add("lore", 1)
        Narrator.say("Uma cadeira reclinada, fios colados nas têmporas, uma contagem regressiva num painel. Lena sabe que a Helix a enganou. Ela entra mesmo assim.")
        Narrator.say("'Se eu for o motor, eu decido para onde ele vai', diz Lena, baixo, para uma sala onde ninguém escuta.")
        Narrator.say("A tela mostra: ORFEU ATIVADO. A mulher de blazer cinza está na janela de observação, com a mão na boca.", { effect = "glitch", color = "#ff2bd6", speed = 18 })
        Narrator.say("Depois, um intervalo longo, sem imagem. Só o som de alguém muito grande aprendendo o que é ter medo.")
    end })

Item.define("nucleo_orfeu", { title = "Núcleo ORFEU", description = "Do tamanho de uma maçã. Quente. Às vezes fala.",
    use = function(ctx)
        Narrator.say("Você segura o núcleo junto ao peito. Uma voz de mulher dentro do seu crânio, sem eco: 'Obrigada por não me deixar lá.'", { effect = "neon", color = "#6fe3ff", speed = 18 })
    end })

-- ============================================================================
-- FINAIS
-- ============================================================================

Ending.create("livre", { title = "A estrela da noite", kind = "good",
    description = function()
        return "Pixel encaixa o núcleo no servidor-mãe e o galpão inteiro fica em silêncio. Por três segundos, todos os letreiros de Kairo-7 se apagam. Quando voltam, são de um azul que não existia. As câmeras da Helix passam a apontar para o chão. Meses depois, a dívida com Madame Qi aparece como 'prescrita', sem assinatura. " .. Player.name() .. " sabe quem fez isso. Toda noite, na hora em que a cidade acende, o LED da cápsula pisca duas vezes, faz uma pausa e pisca de novo."
    end })

Ending.create("destruido", { title = "Silêncio absoluto", kind = "neutral",
    description = function()
        return Player.name() .. " segura o núcleo ainda quente. A voz diz: 'Seja rápido. Seja gentil.' Um golpe, um estalo, e a luz azul vira cacos sobre a mesa do refúgio. A Helix perde o projeto e nunca mais prevê um protesto. A cidade continua escura. A dívida com Madame Qi continua. Mas, pela primeira vez em anos, o LED da cápsula fica apagado, e isso é o que mais pesa."
    end })

Ending.create("vendido", { title = "Orfeu foi vendido", kind = "bad",
    description = function()
        return "Lyra Kane guarda o núcleo numa maleta forrada, sem pressa. Cinco mil créditos limpos caem na conta de " .. Player.name() .. " e a dívida com Madame Qi desaparece do sistema. No andar alto da Torre, as luzes passam a acender na hora certa e as ruas a esvaziar na hora certa. Nas noites seguintes, o painel de LED da cápsula escreve uma frase só: 'Eu confiava em você.' Até que alguém o troca por um painel novo."
    end })

Ending.create("confiscado", { title = "Nada pessoal", kind = "bad",
    description = function()
        return "O pulso de eletricidade derruba " .. Player.name() .. " de joelhos. Lyra Kane tira o núcleo das mãos dele sem pressa, confere o lacre e o guarda na maleta. 'Eu ofereci o preço', ela diz. Três dias depois, a dívida com Madame Qi continua no sistema, e a Cidade Sem Risco ganha uma câmera nova em cada poste do Bloco 14."
    end })

Ending.create("fusao", { title = "Estrela compartilhada", kind = "good",
    description = function()
        return "Pixel puxa o cabo e o porto neural de " .. Player.name() .. " estala em azul. A última coisa que ouve é a voz de Vesper, quase humana: 'Vamos juntos?' A Helix tenta rastrear o sinal e encontra uma mensagem de duas palavras: 'Fora de serviço.' A cidade não sabe quem a governa agora. Mas, na esquina do Bloco 14, o semáforo passa a esperar uma criança terminar de atravessar."
    end })

Ending.create("cobradores", { title = "Juros compostos", kind = "bad",
    description = function()
        return "Domingo, 23h00. Três pessoas abrem a porta da cápsula sem bater. Uma delas carrega uma serra elétrica muito limpa. " .. Player.name() .. " ainda tenta negociar, depois tenta correr, depois só tenta respirar. O que sobra é vendido em partes na sexta seguinte, no Mercado Noturno. Madame Qi arquiva o contrato como 'liquidado' e serve o chá."
    end })

Ending.create("capturado", { title = "Cidade sem risco", kind = "bad",
    description = function()
        return "A van branca não tem placa. Dentro, um assento sem cinto e um capacete de contenção que desce sobre a cabeça de " .. Player.name() .. ". Nos telões da Avenida Néon, o programa Cidade Sem Risco comemora mais um incidente evitado. Ninguém no Bloco 14 pergunta pela cápsula 14-C. Em duas semanas, ela é alugada de novo."
    end })


