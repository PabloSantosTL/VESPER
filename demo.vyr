    actions = {
        { id = "extrair", label = "Extrair o núcleo ORFEU", duration = 20,
          conditions = function(ctx) return State.get("q_main") == 4 end,
          scene = "lab_confronto" },
        { id = "registros", label = "Ler os registros do laboratório (20 min)", duration = 20,
          conditions = function(ctx) return State.get("q_main") >= 4 end,
          scene = "lab_registros" }
    }
})

Room.create("garagem_helix", {
    title = "Subsolo B2 (garagem da Torre)",
    description = "Vagas numeradas, carros brancos sem motorista, uma rampa de saída com a cancela quebrada. Canos de ventilação soltando vapor quente. O concreto liso devolve cada passo com atraso.",
