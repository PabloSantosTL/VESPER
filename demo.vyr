})

Room.create("refugio", {
    title = "Refúgio da Rede Livre",
    save = true,
    description = "Um galpão sob a cidade, com fitas de LED costuradas nas paredes. Hackers dormem em redes. Servidores caseiros zumbem ligados a baterias de carro. Alguém, ao fundo, assobia uma música de antes da Helix.",
    exits = { { id = "bueiro", to = "becos", label = "Subir o bueiro até os becos", duration = 8 } },
    actions = {
