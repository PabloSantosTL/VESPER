-- ============================================================================
-- AMBIENTES
-- ============================================================================

-- ---------- Bloco 14 ----------

Room.create("capsula", {
    title = "Sua cápsula (Bloco 14-C)",
    description = function(ctx)
        local s = "Dois metros por um e meio, teto a oitenta centímetros do rosto. Colchão fino sobre a prateleira de baixo, uma tomada que só funciona com o plugue apertado, um painel de LED na parede que pisca verde quando a rede cai."
        if Time.is_night() then s = s .. " A janela de acrílico mostra o paredão do prédio da frente e, entre dois blocos, uma fatia da Torre Helix." end
        if State.get("chuva") then s = s .. " A chuva ácida escorre no acrílico em linhas esverdeadas." end
        if State.get("heat") >= 4 then s = s .. " Há uma câmera nova aparafusada no poste da janela. Ontem não estava ali." end
        return s
    end,
    exits = { { id = "porta", to = "corredor", label = "Sair para o corredor", duration = 1 } },
    actions = {
        { id = "dormir", label = "Dormir até recuperar (8 h)", duration = 480, save = true,
          execute = function(ctx)
              limpa()
              State.set("cansaco", 0)
              curar(25)
              Narrator.say("O alarme do comunicador toca em volume máximo. Você acorda com a nuca suada e a garganta seca. " .. Time.weekday_name() .. ", dia " .. Time.day() .. ". (Cansaço zerado, +25 saúde)")
          end },
        { id = "cochilar", label = "Cochilar (2 h)", duration = 120,
          execute = function(ctx)
              limpa()
              State.set("cansaco", math.max(0, State.get("cansaco") - 1))
              curar(5)
              Narrator.say("Um sono raso, interrompido duas vezes por passos no corredor. (+5 saúde, menos cansaço)")
          end },
        { id = "pagar", label = "Transferir créditos para Madame Qi", duration = 2,
          conditions = function(ctx) return State.get("divida") > 0 and State.get("creditos") >= 50 end,
          scene = "pagar_qi" },
        { id = "janela", label = "Olhar pela janela (10 min)", duration = 10, scene = "janela_vista" },
        { id = "manual", label = "Abrir o manual do comunicador", duration = 0, scene = "ajuda" }
    }
})

Room.create("corredor", {
    title = "Corredor do Bloco 14",
    description = function(ctx)
        local s = "Corredor estreito, lâmpadas de LED a cada três portas, metade queimada. Fiação exposta no teto, cheiro de curry e solda. Portas de cápsulas empilhadas em dois andares de ferro, cada uma com um adesivo de 'Não perturbe'."
        if State.get("q_gato") < 3 then s = s .. " Um cartaz de gato desaparecido está colado na parede com fita isolante, perto da porta 14-A." end
        return s
    end,
    exits = {
        { id = "capsula", to = "capsula", label = "Entrar na sua cápsula", duration = 1 },
        { id = "elevador", to = "hall_bloco", label = "Descer pelo elevador", duration = 3 },
        { id = "lavanderia", to = "lavanderia", label = "Ir à lavanderia coletiva", duration = 1 },
        { id = "escada", to = "telhado", label = "Subir a escada de incêndio até o telhado", duration = 4, hidden = true }
    },
    actions = {
        falar("ishi"),
        { id = "escutar", label = "Parar e escutar as portas (10 min)", duration = 10, scene = "escuta_portas" }
    }
})

Room.create("lavanderia", {
    title = "Lavanderia coletiva",
    description = "Seis máquinas de moeda, duas com a porta lacrada por fita. Um banco de plástico, um varal de ferro com roupas que ninguém veio buscar, um ventilador de teto que gira sem mover o ar. Cheiro de sabão barato e mofo.",
    exits = { { id = "corredor", to = "corredor", label = "Voltar ao corredor", duration = 1 } },
    actions = {
        { id = "papo", label = "Esperar uma máquina e puxar assunto (25 min)", duration = 25, scene = "papo_lavanderia" },
        { id = "lavar", label = "Lavar o casaco (40 min)", duration = 40, conditions = function() return State.get("creditos") >= 5 end,
          execute = function(ctx)
              limpa()
              State.subtract("creditos", 5)
              Narrator.say("Você coloca cinco créditos, tira o casaco e espera de camiseta. A água que sai do tambor é cinza e depois marrom. (-5 ¢)")
              if State.get("chuva") then Narrator.say("Das mangas sai uma crosta verde: resto de chuva ácida. O tecido está mais fino do que ontem.") end
              State.set("cansaco", math.max(0, State.get("cansaco") - 1))
          end }
    }
})

Room.create("telhado", {
    title = "Telhado do Bloco 14",
    description = function(ctx)
        local s
        if Time.is_night() then
            s = "Antenas, caixas d'água, parabólicas viradas para lugar nenhum. Dali dá para ver a Torre Helix e, abaixo dela, o Distrito 9 inteiro sem espaço entre os prédios."
        else
            s = "Antenas, caixas d'água, roupa em varais de cabo. A cidade vista de cima parece menor e mais suja."
        end
        if State.get("q_gato") >= 3 then s = s .. " Num canto abrigado do vento, caixotes de madeira com terra: a horta da Dona Ishi. Ao lado, um barraco de chapa com pombos." end
        return s
    end,
    exits = {
        { id = "escada", to = "corredor", label = "Descer a escada de incêndio", duration = 4 },
        { id = "pombal", to = "pombal", label = "Entrar no pombal", duration = 1, hidden = true }
    },
    actions = {
        falar("pixel"),
        falar("ishi"),
        { id = "olhar", label = "Ficar olhando a cidade (30 min)", duration = 30,
          execute = function(ctx)
              limpa()
              State.set("cansaco", math.max(0, State.get("cansaco") - 1))
              if Time.is_night() then
                  Narrator.say("Você conta as janelas acesas do prédio em frente e para em quarenta. Em três delas há alguém de pé, de costas, olhando o mesmo que você.")
                  Narrator.say("Embaixo, a avenida pulsa em vermelho e roxo. Nenhum som chega até aqui, só o zumbido das caixas d'água.")
              else
                  Narrator.say("Drones de entrega cruzam o céu em linhas retas e ficam pequenos. Você consegue ficar vinte minutos sem lembrar da dívida. Depois lembra.")
              end
          end },
        { id = "horta", label = "Ajudar na horta (40 min)", duration = 40,
          conditions = function(ctx) return State.get("q_gato") >= 3 and State.get("horta_dia") ~= Time.day() end,
          scene = "horta_ishi" }
    }
})

Room.create("pombal", {
    title = "Pombal de Kenji",
    description = "Barraco de chapa e madeira do tamanho de um armário grande. Gaiolas empilhadas, pombos arrulhando, penas no chão. Uma bancada de solda com ferramentas arrumadas por tamanho, um rádio de ondas curtas verde-militar e um caderno de capa dura preso por elástico.",
    exits = { { id = "telhado", to = "telhado", label = "Voltar ao telhado", duration = 1 } },
    actions = {
        { id = "radio", label = "Ouvir o rádio de Kenji (30 min)", duration = 30, scene = "radio_kenji" },
        { id = "caderno_kenji", label = "Ler o caderno de Kenji (20 min)", duration = 20, scene = "caderno_kenji" }
    }
})

Room.create("hall_bloco", {
    title = "Térreo do Bloco 14",
    description = "Piso de borracha gasto, caixas de correio amassadas, o elevador com a placa 'Lotação 4 (real: 9)'. Na parede, uma TV holográfica presa por quatro parafusos e uma gambiarra de fita. A portaria está vazia há meses; o balcão serve de apoio para quem espera chuva passar.",
    exits = {
        { id = "elevador", to = "corredor", label = "Subir pelo elevador", duration = 3 },
        { id = "rua", to = "rua_neon", label = "Sair para a Avenida Néon", duration = 2 },
        { id = "zeladoria", to = "zeladoria", label = "Entrar na zeladoria", duration = 1, hidden = true }
    },
    actions = {
        { id = "tv", label = "Assistir à TV do hall (5 min)", duration = 5, scene = "jornal" },
        { id = "atras_tv", label = "Olhar atrás da TV (5 min)", duration = 5, hidden = true,
          conditions = function() return not viu("atras_tv") end,
          execute = function(ctx)
              limpa()
              State.set("t_atras_tv", true)
              Narrator.say("Você afasta a TV da parede. Atrás dela, uma porta de metal sem placa. A fechadura está arrancada e remendada com arame.")
              Narrator.say("Alguém usa essa porta com frequência: o chão tem uma trilha limpa até ela.")
              Room.reveal("hall_bloco", "zeladoria")
              Room.reveal("hall_bloco", "atras_tv")
          end }
    }
})

Room.create("zeladoria", {
    title = "Zeladoria do Bloco 14",
    description = "Sala sem janela. Uma caldeira velha, ferramentas penduradas sobre silhuetas pintadas na parede, um colchão de espuma no canto e uma caixa de isopor fechada. Cheiro de ferrugem e de algo adocicado que gruda na garganta.",
    exits = { { id = "hall", to = "hall_bloco", label = "Voltar ao hall", duration = 1 } },
    actions = {
        { id = "isopor", label = "Abrir a caixa de isopor", duration = 3,
          conditions = function() return not viu("isopor_aberto") end,
          execute = function(ctx)
              limpa()
              State.set("t_isopor_aberto", true)
              State.add("lore_bruma", 1)
              Narrator.say("Ampolas de vidro azul-acinzentado, sem etiqueta, em fileiras de dez. Faltam quatro. Dentro da tampa alguém escreveu a lápis: 'Lote 9. Não repor.'")
              Narrator.say("Uma delas está quebrada e seca no fundo da caixa. O cheiro adocicado vem dali.")
          end },
        { id = "mochila", label = "Examinar a mochila térmica no colchão", duration = 3,
          conditions = function() return not viu("mochila_beto") end,
          execute = function(ctx)
              limpa()
              State.set("t_mochila_beto", true)
              Narrator.say("A mochila é amarela, com o logotipo do gato acenando e a frase 'Lámen do Taro: quente em 15 minutos ou grátis'.")
              Narrator.say("Dentro, uma tampa de tigela amassada, um cartão de ponto com a assinatura B. e um bilhete dobrado: 'Taro, hoje eu volto. Juro.' Sem data.")
          end }
    }
})

-- ---------- Avenida ----------

Room.create("rua_neon", {
    title = "Avenida Néon (quadra do Bloco 14)",
    description = function(ctx)
        local s = "Calçada estreita, letreiros em kanji, português e binário, camelôs com mesas dobráveis. Motos magnéticas passam a vinte centímetros de quem não olha. O chão é uma crosta de chiclete e óleo. Do lado do Bloco 14 fica o Lámen do Taro; do outro, a feira de peças."
        if Time.is_night() then s = s .. " À noite os letreiros competem em volume e quase ninguém para de andar." end
        if State.get("heat") >= 3 then s = s .. " Drones da Helix passam mais baixo que o normal." end
        return s .. clima()
    end,
    exits = {
        { id = "bloco", to = "hall_bloco", label = "Entrar no Bloco 14", duration = 2 },
        { id = "noodle", to = "noodle_bar", label = "Entrar no Lámen do Taro", duration = 1 },
        { id = "feira", to = "feira", label = "Ir à feira de peças", duration = 2 },
        { id = "sul", to = "cruzamento", label = "Seguir a avenida para o sul", duration = 6 }
    },
    actions = {
        { id = "observar", label = "Parar e observar a avenida (10 min)", duration = 10, scene = "observar_rua" }
    }
})

Room.create("feira", {
    title = "Feira de peças",
    description = "Meia dúzia de barracas de lona sobre caixotes. Placas de circuito empilhadas por cor, cabos enrolados em braços de manequim, lentes de olho artificial em potes de vidro. Os camelôs conversam entre si e não olham para a mercadoria.",
    exits = { { id = "rua", to = "rua_neon", label = "Voltar à avenida", duration = 2 } },
    actions = {
        falar("ishi"),
        { id = "conversar", label = "Conversar com os camelôs (15 min)", duration = 15, scene = "camelos" },
        { id = "feira", label = "Garimpar as barracas (20 min)", duration = 20,
          execute = function(ctx)
              limpa()
              local r = math.random(1, 10)
              if r >= 9 then
                  Narrator.say("No fundo de uma caixa de conectores, um chip de crédito velho, com saldo. O dono da barraca está olhando para outro lado e não pergunta.")
                  ganha(35)
              elseif r <= 2 then
                  Narrator.say("Um camelô tenta vender um 'implante legítimo': um mouse com fita isolante e dois LEDs colados. Ele jura que já salvou três vidas.")
              else
                  Narrator.say("Você revira fios por vinte minutos. Acha uma bateria que ainda segura carga e uma mão mecânica de criança. Nada que valha pagar.")
              end
          end }
    }
})

Room.create("noodle_bar", {
    title = "Lámen do Taro",
    description = function(ctx)
        local s = "Balcão de seis banquetas parafusadas no chão, panelas de aço do tamanho de pneus soltando vapor, uma TV velha pendurada no canto passando propaganda. Um holograma de gato acenando ('Bem-vindo!') treme sobre a porta, com o braço quebrado."
        if ativ("taro") == "dormindo" then s = s .. " A cortina de ferro está meio baixada e o balcão está apagado. Alguém ronca atrás do biombo." end
        return s .. clima()
    end,
    exits = {
        { id = "rua", to = "rua_neon", label = "Sair para a avenida", duration = 1 },
        { id = "cozinha", to = "cozinha_taro", label = "Passar para a cozinha", duration = 1, hidden = true }
    },
    actions = {
        falar("taro"),
        falar("rex"),
        { id = "comer", label = "Pedir uma tigela de lámen", duration = 25,
          conditions = function(ctx)
              local custo = State.get("taro_amigo") and 8 or 15
              return ativ("taro") ~= "dormindo" and State.get("creditos") >= custo
          end,
          execute = function(ctx)
              limpa()
              local custo = State.get("taro_amigo") and 8 or 15
              State.subtract("creditos", custo)
              curar(15)
              Narrator.say("Taro bate a tigela no balcão e empurra os hashis. Caldo ardendo, macarrão quase de verdade, uma gema mole por cima. Você come em silêncio. (-" .. custo .. " ¢, +15 saúde)")
          end },
        { id = "ajudar", label = "Ajudar na cozinha por uma hora", duration = 60,
          conditions = function(ctx)
              return ativ("taro") ~= "dormindo" and State.get("ajudou_dia") ~= Time.day() and State.get("met_taro")
          end,
          scene = "ajudar_taro" },
        { id = "tv_taro", label = "Assistir à TV do balcão (5 min)", duration = 5, scene = "jornal" }
    }
})

Room.create("cozinha_taro", {
    title = "Cozinha do Taro",
    description = "Cozinha de três metros quadrados: fogão de seis bocas, pia de aço com a torneira presa por arame, caixas de macarrão até o teto. Uma geladeira com ímã de gato e um calendário com os dias riscados a caneta. A porta dos fundos dá para um beco. Cheiro de alho queimado e detergente.",
    exits = {
        { id = "balcao", to = "noodle_bar", label = "Voltar ao balcão", duration = 1 },
        { id = "fundos", to = "becos", label = "Sair pela porta dos fundos", duration = 2 }
    },
    actions = {
        falar("taro"),
        { id = "calendario", label = "Olhar o calendário", duration = 2,
          conditions = function() return not viu("calendario_taro") end,
          execute = function(ctx)
              limpa()
              State.set("t_calendario_taro", true)
              Narrator.say("Os dias riscados vão até uma data de dez dias atrás. Nessa, em vez de X, alguém desenhou um círculo. Embaixo: 'Beto não veio.'")
              Narrator.say("Todos os dias depois dessa data têm um segundo risco, mais fraco, como se Taro esperasse e depois desistisse de esperar.")
          end }
    }
})

Room.create("cruzamento", {
    title = "Cruzamento do Sinapse",
    description = function(ctx)
        local s = "Quatro ruas se encontram sob um telão que nunca desliga. Carrocinha de café sintético, ponto de moto-táxi, uma escada que desce para o NetHaven e uma porta de luz roxa com a palavra SINAPSE. Ao norte ficam a Avenida Néon e o Bloco 14. Ao sul, a rua desce mais escura."
        if State.get("heat") >= 3 then s = s .. " Um carro branco está parado na esquina, com o motor ligado, há muito tempo." end
        return s .. clima()
    end,
    exits = {
        { id = "norte", to = "rua_neon", label = "Voltar pela Avenida Néon", duration = 6 },
        { id = "bar", to = "bar_sinapse", label = "Entrar no Bar Sinapse", duration = 2 },
        { id = "nexus", to = "nexus", label = "Descer para o NetHaven", duration = 2 },
        { id = "sul", to = "av_baixa", label = "Descer pela Avenida Baixa", duration = 6 },
        { id = "fachadas", to = "fachadas", label = "Seguir pela Rua das Fachadas Brancas", duration = 12, hidden = true }
    },
    actions = {
        falar("mira"),
        { id = "telao", label = "Assistir ao telão (5 min)", duration = 5, scene = "jornal" }
    }
})

Room.create("bar_sinapse", {
    title = "Bar Sinapse",
    description = function(ctx)
        local s = "Luz roxa, reservados de vinil rasgado, um balcão de aço com o androide Bartô limpando o mesmo copo. Cheiro de gelo derretido e de álcool de verdade, raro e caro. A máquina de música toca sempre a mesma faixa instrumental."
        if Time.is_night() then s = s .. " À noite as mesas do fundo ficam ocupadas por gente que fala sem mover o rosto." end
        return s
    end,
    exits = { { id = "cruzamento", to = "cruzamento", label = "Sair para o cruzamento", duration = 2 } },
    actions = {
